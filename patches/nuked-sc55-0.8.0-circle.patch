+        int rcadd2[6] = {};
+
+        {
+            {
+                // 1
+                int v1 = pcm.ram2[30][4];
+                int m1 = multi((int32_t)pcm.ram1[29][0], (int8_t)(v1 >> 8)) >> 6;
+                int v2 = 0;
+                int s1 = eram_unpack(pcm, pcm.ram2[28][1] + pcm.tv_counter, 1);
