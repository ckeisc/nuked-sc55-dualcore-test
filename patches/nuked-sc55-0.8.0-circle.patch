+                ram2[9] = 0;
+                ram2[10] = 0;
+            }
+        };
+        int slot = 0;
+        for (; slot + 1 < pcm.config.reg_slots; slot += 2)
+        {
+            PipeCtx c0{};
+            PipeCtx c1{};
+            head_slot(slot, c0);
+            head_slot(slot + 1, c1);
+            tail_slot(slot, c0);
+            tail_slot(slot + 1, c1);
+        }
+        for (; slot < pcm.config.reg_slots; slot++)
