+                pcm.ram1[31][1] = (uint32_t)suml;
+                pcm.ram1[31][3] = (uint32_t)sumr;
+            }
+            else
+            {
+                pcm.accum_l = suml;
+                pcm.accum_r = sumr;
+            }
