+
+            preshift = samp1 << 10;
+            select_nibble = nibble_cmp3 ? ctx.old_nibble : ctx.newnibble;
+            shift = (10 - select_nibble) & 15;
+
+            shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 2)
