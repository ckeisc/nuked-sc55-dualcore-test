+                    "ldr q4, [%[pRc]]\n\t"
+                    "ldr q5, [%[pInjL]]\n\t"
+                    "ldr q6, [%[pInjR]]\n\t"
+                    "ldr q7, [%[pInjC0]]\n\t"
+                    "ldr q8, [%[pInjC1]]\n\t"
