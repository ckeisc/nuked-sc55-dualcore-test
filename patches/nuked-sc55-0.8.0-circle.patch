+            select_nibble = nibble_cmp5 ? ctx.old_nibble : ctx.newnibble;
+            shift = (10 - select_nibble) & 15;
+
+            shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 4)
