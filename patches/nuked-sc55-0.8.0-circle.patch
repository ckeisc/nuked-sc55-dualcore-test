+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+/*
+ * split_thread_circle.h -- skeletal JV880-shape sync for the mt32-pi
+ * minimal validity kernel (Sterr1/Mini-JV880pi shape, adapted), with
+ * the ROUND-3 sync profiles (2026-10-31).
+ *
+ * The base shape is unchanged from the shaped-var kernel:
+ * - SHARED pcm state: both cores use the SAME pcm_t in memory.
+ *   MCU_Write writes registers DIRECTLY into it; MCU_Read reads
+ *   DIRECTLY from it. No shadows for live reads.
+ * - CYCLE-COUNT PUBLISH: core 2 RELEASE-stores mcu.cycles (every
+ *   step in the legacy profile; every N steps in the round-3
+ *   profiles, see the publish-interval argument below). Core 3
+ *   ACQUIRE-loads it and renders ONLY up to that target minus one
+ *   max tick (800 cycles), never beyond.
+ * - CORE-3 BATCHES: bounded (128 ticks), idle-wait via yield hint.
+ *
+ * ROUND 3 (what this header adds -- all selected at RUN TIME through
+ * the SplitSyncProfile the kernel copies into the state at
+ * activation, so every profile runs from one kernel image and the
+ * auto-sequence can A/B them on real hardware):
+ *
+ * (1) LAYOUT: the state is split onto separate 64-byte cache lines by
+ *     writer: the lock words, the core-2 -> core-3 published cycle
+ *     count, the core-3-written stats, the core-2-written stats, and
+ *     the read-mostly configuration. The old layout put the lock, the
+ *     per-step published counter and both cores' per-batch/per-op
+ *     stats on ONE line, so every core-2 publish and every core-3
+ *     batch end bounced that line between the cores.
+ *
+ * (2) PUBLISH INTERVAL: cycles_pub is published every
+ *     sync.publish_interval steps (1 = legacy). Correctness: core 3
+ *     renders only ticks ending <= published - 800. A tick ending at E
+ *     needs the register writes of every step k with 12*(k-1) < E,
+ *     i.e. 12k < E + 12. Core 3 only renders E after ACQUIRE-loading a
+ *     published value P >= E + 800, and the RELEASE store of P
+ *     happened after step P/12, so every step k with 12k <= P is
+ *     visible. Since E + 12 <= P - 788 < P, the needed steps are
+ *     visible for ANY publish spacing; the 800-cycle cap already
+ *     covers 66 steps of slack. The kernel caps the interval at 32
+ *     (384 cycles, well under one tick) and always publishes once more
+ *     at the end of a step loop so the render position never waits
+ *     for the next chunk.
+ *
+ * (3) LOCK MODES (sync.lock_mode):
+ *     BATCH (legacy): core 3 holds the state lock for a whole batch;
+ *       core 2 takes it for each committing ram1/ram2 store and each
+ *       status read (0x3c/0x3e). Core 2 can therefore wait for up to
+ *       a whole batch.
+ *     TICK: as BATCH, but core 3 hands the lock over at every tick
+ *       boundary when core 2 has announced a wait (writer_want): core
+ *       3 releases, waits until core 2 has taken the lock, then
+ *       re-acquires (it then waits for core 2's single store, not the
+ *       other way round). Core 2's wait is bounded by ONE tick.
+ *     FREE: no lock anywhere. Core 2 stores straight into ram1/ram2
+ *       while core 3 may be mid-tick. EXPERIMENT ONLY: it bounds the
+ *       gain available from removing the lock, but a core-2 store can
+ *       be lost to a concurrent core-3 read-modify-write of the same
+ *       word (ram2[slot][7] key/nibble update, ram2[slot][8] phase,
+ *       ram1[slot][4] address writeback). Never ship.
+ *     FIFO: core 2 never blocks. Each committing store is pushed as a
+ *       (ram, channel, index, value) record into a single-producer
+ *       single-consumer FIFO; core 3 applies all pending records at
+ *       each TICK BOUNDARY, in order, before rendering the tick. This
+ *       is exactly the single-threaded emulator's semantics: in
+ *       MCU_Step a register write (inside the instruction) always
+ *       lands BEFORE the PCM_Update that follows the step, i.e. at a
+ *       tick boundary, never mid-tick. Core 2's own latch reads of
+ *       ram1/ram2 consult the pending records first (newest wins), so
+ *       read-your-own-write holds exactly as in the single-threaded
+ *       engine; words core 3 mutates (envelopes, addresses) read live,
+ *       as they did before (unlocked in Sterr1 and here).
+ *
+ * (4) IRQ0 HAND-OFF (sync.legacy_irq = 0): core 3 no longer calls
+ *     MCU_Interrupt_SetRequest(IRQ0, 1) itself. That call is a
+ *     read-modify-write of mcu.interrupt_pending, a word core 2 also
+ *     read-modify-writes WITHOUT the state lock every step (timer
+ *     Include/Exclude, interrupt take). The legacy path therefore has
+ *     a real lost-update window (core 3 under the lock vs core 2's
+ *     timers outside it). Round 3 raises a one-byte flag (irq0_req)
+ *     with a RELEASE store; core 2 folds it into interrupt_pending at
+ *     the top of its next step. All interrupt_pending writers are
+ *     then core 2. The status-read ACK (0x3e) clears irq_assert with
+ *     an atomic exchange, so no lock is needed around it either.
+ *
+ * (5) INSTRUMENTATION COST: the shaped-var kernel timed every core-2
+ *     lock op with two CTimer::GetClockTicks() calls (ISB + counter
+ *     read + 64-bit divide each) and two ISB-fenced PMU reads. Round-3
+ *     profiles time a lock op only when the first try-acquire fails,
+ *     with unfenced PMU reads (lock_contended counts those ops;
+ *     lock_wait_us is derived from lock_wait_cyc at 1 GHz).
+ *
+ * (6) The Circle CSpinLock (default IRQ_LEVEL) runs EnterCritical /
+ *     LeaveCritical (DAIF save/restore + per-core nesting arrays +
+ *     DMB) around a WFE spin. Cores 2 and 3 take no device IRQs
+ *     (Circle routes them to core 0), so round-3 profiles use a raw
+ *     TASK-level spinlock (LDAXR/STXR try, STLR release) instead
+ *     (sync.legacy_lock = 0). The legacy profile keeps CSpinLock.
+ *
+ * Every profile shares one pcm_t and one set of PCM_Update variants;
+ * only the coordination changes. Profile 0 reproduces the shaped-var
+ * kernel's behaviour exactly (every knob at its legacy value), so the
+ * old baseline remains the reference.
+ *
+ * Scope: MK1 only, as before.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <utility>
+
+#include <circle/spinlock.h>
+#include <circle/synchronize.h>
+#include <circle/timer.h>
+
+#include "mcu.h"
+#include "mcu_interrupt.h"
+#include "pcm.h"
+
+// Local cross-core barrier ("dmb ish": inner-shareable, the right
+// domain for visibility between cores of one SoC).
+static inline void SplitDMB()
+{
+    __asm__ volatile ("dmb ish" ::: "memory");
+}
+// Scheduler-free pause: this kernel registers no CScheduler tasks,
+// so Yield() can never return. ARM YIELD hint.
+static inline void SplitPause()
+{
+    __asm__ volatile ("yield" ::: "memory");
+}
+
+// PMU cycle-counter reads. PMU_ReadCycles is the fenced read (isb
+// first: exact, used for the per-window/per-batch brackets).
+// PMU_ReadCyclesFast omits the isb: a few cycles of skew, used only
+// inside the hot lock path (round-3 profiles) where an isb per op
+// would itself be a measurable cost.
+static inline uint64_t PMU_ReadCycles()
+{
+    uint64_t nCycles = 0;
+    __asm__ volatile ("isb; mrs %0, pmccntr_el0" : "=r" (nCycles));
+    return nCycles;
+}
+static inline uint64_t PMU_ReadCyclesFast()
+{
+    uint64_t nCycles = 0;
+    __asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (nCycles));
+    return nCycles;
+}
+
+// Variant descriptor table (data-driven dispatch): number, short
+// name, full name, and PCM_Update implementation. Defined in pcm.cpp.
+struct PCMVariantDesc {
+    int number;
+    const char* short_name;
+    const char* full_name;
+    void (*update)(pcm_t& pcm, uint64_t cycles);
+};
+extern const PCMVariantDesc g_pcmVariants[];
+extern const int g_pcmVariantCount;
+
+// Table-driven dispatcher (defined in pcm.cpp).
+void PCM_Update_Variant(pcm_t& pcm, uint64_t cycles, int variant);
+
+// ---------------------------------------------------------------------------
+// Round-3 sync profile (runtime-selected coordination parameters).
+// ---------------------------------------------------------------------------
+enum SplitLockMode : uint8_t {
+    SPLIT_LOCK_BATCH = 0,   // legacy: whole-batch hold on core 3
+    SPLIT_LOCK_TICK  = 1,   // per-tick hand-off when core 2 waits
+    SPLIT_LOCK_FREE  = 2,   // no lock (EXPERIMENT: lost-update hazard)
+    SPLIT_LOCK_FIFO  = 3,   // deferred stores applied at tick boundaries
+};
+
+struct SplitSyncProfile {
+    int         number;
+    const char* short_name;
+    const char* full_name;
+    uint8_t     lock_mode;            // SplitLockMode
+    uint8_t     legacy_lock;          // 1 = Circle CSpinLock (IRQ_LEVEL), 0 = raw TASK-level spinlock
+    uint8_t     legacy_timing;        // 1 = CTimer + fenced PMU reads around EVERY lock op (shaped-var), 0 = contended-only, unfenced
+    uint8_t     legacy_irq;           // 1 = core 3 calls MCU_Interrupt_SetRequest(IRQ0) directly, 0 = irq0_req flag folded by core 2
+    uint16_t    publish_interval;     // steps between cycles_pub RELEASE stores (1 = every step)
+    uint16_t    ring_check_interval;  // steps between ring Avail() checks in the step loop (1 = every step)
+    uint16_t    core3_backoff;        // yield-hint iterations between idle polls of cycles_pub (0 = tight spin)
+};
+
+// Deferred-store FIFO (SPLIT_LOCK_FIFO). Records are PCMDeferredStore
+// (declared in pcm.h, produced by PCM_WriteDeferred), applied by
+// core 3 at a tick boundary.
+static constexpr uint32_t SplitFifoSize = 4096;      // records; power of two
+static constexpr uint32_t SplitFifoMask = SplitFifoSize - 1;
+
+struct ThreadSplitStateCircle;
+
+// Owned by the app (CMinimalApp): set when the split is activated
+// (after priming / on reset, with the PCM task stopped), cleared on
+// teardown so a stale state can never dispatch.
+extern ThreadSplitStateCircle* g_splitT;
+
+struct alignas(64) ThreadSplitStateCircle {
+    // ---- line 0: lock words (written by both cores, rarely) ----
+    // Legacy lock (CSpinLock WITH Circle's IRQ_LEVEL critical section),
+    // used by profiles with legacy_lock = 1.
+    CSpinLock state_lock;
+    // Raw TASK-level spinlock word (0 = free, 1 = held), profiles with
+    // legacy_lock = 0.
+    uint32_t raw_lock{0};
+    // SPLIT_LOCK_TICK hand-off flag: core 2 sets it (RELEASE) before
+    // spinning on the lock, clears it once it holds the lock; core 3
+    // polls it at every tick boundary.
+    uint32_t writer_want{0};
+
+    // ---- line 1: core 2 -> core 3 published cycle count ----
+    // Plain field, accessed ONLY via __atomic builtins cross-core:
+    // core 2 stores with RELEASE, core 3 loads with ACQUIRE.
+    alignas(64) uint64_t cycles_pub{0};
+
+    // ---- line 2: core-3-written, core-2-read ----
+    alignas(64) volatile uint64_t pcm_rendered{0};
+    volatile uint64_t pcm_task_us{0};
+    volatile uint64_t max_pcm_lag{0};
+    volatile uint64_t pcm_task_cyc{0};   // core-3 total PCM task work (same scope as pcm_task_us)
+    volatile uint64_t mix_cyc{0};        // core-3 voice-mix portion per batch
+    volatile uint64_t ticks{0};          // PCM ticks rendered (counted in DrainBeforeTick, every variant)
+    volatile uint64_t fifo_tail{0};      // FIFO consumer index (core 3)
+    // IRQ0 request flag: core 3 sets 1 (RELEASE) when a voice-end IRQ
+    // is asserted (legacy_irq = 0); core 2 folds it into
+    // interrupt_pending at the top of its next step.
+    volatile uint8_t  irq0_req{0};
+
+    // ---- line 3: core-3 PMU event snapshots (core 3 writes per batch) ----
+    alignas(64) volatile uint64_t c3_ev[4]{0, 0, 0, 0};
+
+    // ---- line 4: core-2-written, core-2-read (window writer is core 2) ----
+    alignas(64) volatile uint64_t lock_wait_us{0};   // legacy timing only (CTimer); derived from cycles otherwise
+    volatile uint64_t lock_waits{0};                 // every core-2 lock op
+    volatile uint64_t lock_wait_cyc{0};              // core-2 spin cycles (NOP-corrected in legacy timing)
+    volatile uint64_t lock_contended{0};             // core-2 lock ops whose first try failed (round-3 timing)
+    volatile uint64_t publishes{0};                  // cycles_pub RELEASE stores
+    volatile uint64_t fifo_full_waits{0};            // FIFO pushes that had to wait for core 3 (must be 0)
+    volatile uint64_t fifo_hw{0};                    // FIFO depth high-water mark
+    volatile uint64_t irq0_folded{0};                // IRQ0 flags folded by core 2
+
+    // ---- line 5: FIFO producer index + core-2-private caches ----
+    alignas(64) volatile uint64_t fifo_head{0};      // FIFO producer index (core 2)
+    uint64_t fifo_tail_cache{0};                      // core-2 private copy of fifo_tail
+
+    // ---- line 6: read-mostly configuration ----
+    alignas(64) volatile uint64_t nop_cyc2{0};       // each core's back-to-back double-read cost
+    volatile uint64_t nop_cyc3{0};
+    SplitSyncProfile sync{0, "legacy", "legacy", SPLIT_LOCK_BATCH, 1, 1, 1, 1, 1, 0};
+
+    // Batch discipline: a tick is at most (31+1)*25 = 800 cycles, and
+    // a batch renders at most 128 ticks (Sterr1's 128-sample bound).
+    static constexpr uint64_t MaxTickCycles = 800;
+    static constexpr uint64_t MaxBatchTicks = 128;
+
+    // ---- FIFO storage (its own lines; written by core 2, read by core 3) ----
+    alignas(64) PCMDeferredStore fifo[SplitFifoSize]{};
+
+    // --- raw lock primitives (legacy_lock = 0) ---
+    bool RawTryAcquire()
+    {
+        return __atomic_exchange_n(&raw_lock, 1u, __ATOMIC_ACQUIRE) == 0u;
+    }
+    void RawAcquire()
+    {
+        while (!RawTryAcquire())
+        {
+            while (__atomic_load_n(&raw_lock, __ATOMIC_RELAXED) != 0u)
+                SplitPause();
+        }
+    }
+    void RawRelease()
+    {
+        __atomic_store_n(&raw_lock, 0u, __ATOMIC_RELEASE);
+    }
+
+    // Core-3 side of the state lock (batch acquire/release, and the
+    // TICK hand-off). Which lock object is used follows the profile.
+    void Core3Acquire()
+    {
+        if (sync.legacy_lock)
+            state_lock.Acquire();
+        else
+            RawAcquire();
+    }
+    void Core3Release()
+    {
+        if (sync.legacy_lock)
+            state_lock.Release();
+        else
+            RawRelease();
+    }
+    // Does core 3 hold the state lock across a batch in this profile?
+    bool Core3LocksBatch() const
+    {
+        return sync.lock_mode == SPLIT_LOCK_BATCH || sync.lock_mode == SPLIT_LOCK_TICK;
+    }
+
+    // Apply every pending deferred store (SPLIT_LOCK_FIFO), core 3,
+    // tick boundary. One ACQUIRE load of the producer index per tick
+    // in the common (empty) case.
+    void FifoDrain(pcm_t& pcm)
+    {
+        uint64_t nTail = fifo_tail;
+        const uint64_t nHead = __atomic_load_n(&fifo_head, __ATOMIC_ACQUIRE);
+        if (nHead == nTail)
+            return;
+        while (nTail != nHead)
+        {
+            const PCMDeferredStore& st = fifo[nTail & SplitFifoMask];
+            if (st.is_ram2)
+                pcm.ram2[st.channel][st.index] = static_cast<uint16_t>(st.value);
+            else
+                pcm.ram1[st.channel][st.index] = st.value;
+            ++nTail;
+        }
+        __atomic_store_n(&fifo_tail, nTail, __ATOMIC_RELEASE);
+    }
+
+    // Push one deferred store (core 2). Never drops: if the FIFO is
+    // full (4096 pending stores -- impossible in practice, core 3
+    // drains every tick) it waits for core 3 and counts the wait.
+    void FifoPush(const PCMDeferredStore& st)
+    {
+        const uint64_t nHead = fifo_head;
+        if (nHead - fifo_tail_cache >= SplitFifoSize)
+        {
+            fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+            if (nHead - fifo_tail_cache >= SplitFifoSize)
+            {
+                fifo_full_waits = fifo_full_waits + 1;
+                do
+                {
+                    SplitPause();
+                    fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+                } while (nHead - fifo_tail_cache >= SplitFifoSize);
+            }
+        }
+        fifo[nHead & SplitFifoMask] = st;
+        __atomic_store_n(&fifo_head, nHead + 1, __ATOMIC_RELEASE);
+        const uint64_t nDepth = nHead + 1 - fifo_tail_cache;
+        if (nDepth > fifo_hw)
+            fifo_hw = nDepth;
+    }
+
+    // Core-2 read-your-own-write overlay (SPLIT_LOCK_FIFO): the newest
+    // pending store to (ram, channel, index), if any. Scans newest to
+    // oldest; the FIFO is usually empty or a few records deep.
+    bool FifoLookup(bool bRam2, uint8_t nChannel, uint8_t nIndex, uint32_t* pValue)
+    {
+        const uint64_t nHead = fifo_head;
+        fifo_tail_cache = __atomic_load_n(&fifo_tail, __ATOMIC_ACQUIRE);
+        uint64_t n = nHead;
+        while (n != fifo_tail_cache)
+        {
+            --n;
+            const PCMDeferredStore& st = fifo[n & SplitFifoMask];
+            if ((st.is_ram2 != 0) == bRam2 && st.channel == nChannel && st.index == nIndex)
+            {
+                *pValue = st.value;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Per-tick hook, called by EVERY PCM_Update variant at the top of
+    // each tick (core 3). Counts ticks and runs the mode's boundary
+    // work: FIFO drain, or the TICK hand-off. BATCH/FREE: count only.
+    void DrainBeforeTick(pcm_t& pcm)
+    {
+        ticks = ticks + 1;
+        switch (sync.lock_mode)
+        {
+        case SPLIT_LOCK_FIFO:
+            FifoDrain(pcm);
+            break;
+        case SPLIT_LOCK_TICK:
+            if (__atomic_load_n(&writer_want, __ATOMIC_ACQUIRE) != 0u)
+            {
+                Core3Release();
+                // Wait until core 2 holds the lock (it clears
+                // writer_want right after acquiring), then queue
+                // behind its single store.
+                while (__atomic_load_n(&writer_want, __ATOMIC_ACQUIRE) != 0u)
+                    SplitPause();
+                Core3Acquire();
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    void PublishRenderedStep(pcm_t&, uint64_t) {
+    }
+
+    void DrainIrq(mcu_t&) {
+    }
+
+    // (Re)initialize from a live pcm_t after single-threaded priming
+    // or an emulator reset. The caller guarantees the PCM task is
+    // stopped (app handshake) and the MCU thread is not stepping.
+    // The FIFO is empty by construction here (core 3 drained it
+    // before parking, and no MCU step ran since), so resetting both
+    // indices is safe. Cumulative counters are deliberately NOT reset
+    // (the app snapshots them per window).
+    void InitFromPCM(pcm_t& pcm, mcu_t& mcu) {
+        cycles_pub = (uint64_t)mcu.cycles;
+        pcm_rendered = pcm.cycles;
+        pcm_task_us = 0;
+        max_pcm_lag = 0;
+        fifo_head = 0;
+        fifo_tail = 0;
+        fifo_tail_cache = 0;
+        irq0_req = 0;
+        writer_want = 0;
+        raw_lock = 0;
+    }
+};
+
+// ---------------------------------------------------------------------------
+// Core-2 lock path.
+// ---------------------------------------------------------------------------
+inline void SplitCore2Acquire(ThreadSplitStateCircle& s)
+{
+    if (s.sync.legacy_lock)
+    {
+        // shaped-var instrumentation, verbatim: two CTimer reads + two
+        // fenced PMU reads per op when legacy_timing is set.
+        if (s.sync.legacy_timing)
+        {
+            const uint64_t t0 = CTimer::GetClockTicks();
+            const uint64_t c0 = PMU_ReadCycles();
+            s.state_lock.Acquire();
+            s.lock_wait_us = s.lock_wait_us + (CTimer::GetClockTicks() - t0);
+            const uint64_t cDelta = PMU_ReadCycles() - c0;
+            const uint64_t cNop = s.nop_cyc2;
+            s.lock_wait_cyc = s.lock_wait_cyc + (cDelta >= cNop ? cDelta - cNop : 0);
+        }
+        else
+        {
+            s.state_lock.Acquire();
+        }
+        s.lock_waits = s.lock_waits + 1;
+        return;
+    }
+    if (s.sync.lock_mode == SPLIT_LOCK_TICK)
+        __atomic_store_n(&s.writer_want, 1u, __ATOMIC_RELEASE);
+    if (!s.RawTryAcquire())
+    {
+        s.lock_contended = s.lock_contended + 1;
+        const uint64_t c0 = PMU_ReadCyclesFast();
+        s.RawAcquire();
+        s.lock_wait_cyc = s.lock_wait_cyc + (PMU_ReadCyclesFast() - c0);
+    }
+    if (s.sync.lock_mode == SPLIT_LOCK_TICK)
+        __atomic_store_n(&s.writer_want, 0u, __ATOMIC_RELAXED);
+    s.lock_waits = s.lock_waits + 1;
+}
+
+inline void SplitCore2Release(ThreadSplitStateCircle& s)
+{
+    if (s.sync.legacy_lock)
+        s.state_lock.Release();
+    else
+        s.RawRelease();
+}
+
+// Core 3's voice-end IRQ assert. Called at the 4 PCM_Update assert
+// sites (baseline + 3 variants) in place of the direct
+// MCU_Interrupt_SetRequest(IRQ0, 1). pcm.irq_assert / irq_channel are
+// already set by the caller. Legacy profile: the direct call (as
+// shipped). Round 3: one-byte flag with RELEASE, folded by core 2.
+inline void SplitAssertIrq0(pcm_t& pcm)
+{
+    if (g_splitT && !g_splitT->sync.legacy_irq)
+        __atomic_store_n(&g_splitT->irq0_req, static_cast<uint8_t>(1), __ATOMIC_RELEASE);
+    else
+        MCU_Interrupt_SetRequest(*pcm.mcu, INTERRUPT_SOURCE_IRQ0, 1);
+}
+
+// Core 2: fold a pending IRQ0 request into interrupt_pending. Called
+// at the top of every step by the kernel's step loop (one ACQUIRE
+// byte load; the line is written by core 3 only on voice ends).
+inline void SplitFoldIrq0(ThreadSplitStateCircle& s, mcu_t& mcu)
+{
+    if (__atomic_load_n(&s.irq0_req, __ATOMIC_ACQUIRE) != 0u)
+    {
+        __atomic_exchange_n(&s.irq0_req, static_cast<uint8_t>(0), __ATOMIC_ACQ_REL);
+        MCU_Interrupt_SetRequest(mcu, INTERRUPT_SOURCE_IRQ0, 1);
+        s.irq0_folded = s.irq0_folded + 1;
+    }
+}
+
+// MCU thread: direct register write into shared pcm state. Which
+// writes COMMIT a ram1/ram2 store is backend PCM_Write verbatim:
+// ram1 (0x04-0x10, 0x24-0x30) commits iff (addr&3)==3;
+// ram2 (0x10-0x20, 0x30-0x38) commits iff (addr&1)==1. Non-committing
+// bytes only touch core-2-private latch state and never synchronize.
+inline void SkelPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value) {
+    addr &= 0x3f;
+    const bool bCommits =
+        ((((addr >= 0x04 && addr < 0x10) || (addr >= 0x24 && addr < 0x30)) && ((addr & 3) == 3)) ||
+         (((addr >= 0x10 && addr < 0x20) || (addr >= 0x30 && addr < 0x38)) && ((addr & 1) == 1)));
+    if (!bCommits)
+    {
+        PCM_Write(*mcu.pcm, addr, value);
+        return;
+    }
+    ThreadSplitStateCircle& s = *g_splitT;
+    switch (s.sync.lock_mode)
+    {
+    case SPLIT_LOCK_FREE:
+        PCM_Write(*mcu.pcm, addr, value);
+        return;
+    case SPLIT_LOCK_FIFO:
+    {
+        PCMDeferredStore st;
+        if (PCM_WriteDeferred(*mcu.pcm, addr, value, &st))
+            s.FifoPush(st);
+        return;
+    }
+    default:
+        SplitCore2Acquire(s);
+        PCM_Write(*mcu.pcm, addr, value);
+        SplitCore2Release(s);
+        return;
+    }
+}
+
+// MCU thread: direct read from shared pcm state. Status reads
+// (0x3c/0x3e, including the IRQ-ack clear) hold the state lock in the
+// BATCH/TICK modes (Sterr1's scope); in FREE/FIFO they run lock-free
+// with an atomic exchange on irq_assert. FIFO mode consults the
+// pending stores for latch reads (read-your-own-write).
+inline uint8_t SkelPCMRead(mcu_t& mcu, uint32_t addr) {
+    addr &= 0x3f;
+    ThreadSplitStateCircle& s = *g_splitT;
+    if (addr == 0x3c || addr == 0x3e) {
+        const bool bLocked = (s.sync.lock_mode == SPLIT_LOCK_BATCH || s.sync.lock_mode == SPLIT_LOCK_TICK);
+        if (bLocked)
+            SplitCore2Acquire(s);
+        uint8_t value;
+        if (s.sync.legacy_irq)
+        {
+            value = PCM_Read(*mcu.pcm, addr);
+        }
+        else
+        {
+            // PCM_Read's status branch, with the irq_assert clear as
+            // an atomic exchange (core 3 sets it with a byte store).
+            pcm_t& pcm = *mcu.pcm;
+            uint8_t status = 0;
+            if (addr == 0x3e)
+            {
+                if (__atomic_exchange_n(&pcm.irq_assert, false, __ATOMIC_ACQ_REL))
+                    MCU_Interrupt_SetRequest(mcu, INTERRUPT_SOURCE_IRQ0, 0);
+            }
+            status |= pcm.irq_channel;
+            if (pcm.voice_mask_updating)
+                status |= 32;
+            value = status;
+        }
+        if (bLocked)
+            SplitCore2Release(s);
+        return value;
+    }
+    if (s.sync.lock_mode == SPLIT_LOCK_FIFO && s.fifo_head != s.fifo_tail_cache)
+    {
+        // Latch reads (PCM_Read's ram1/ram2 branches) see pending
+        // stores first. Index derivations are PCM_Read verbatim.
+        pcm_t& pcm = *mcu.pcm;
+        if (((addr >= 0x4 && addr < 0x10) || (addr >= 0x24 && addr < 0x30)) && (addr & 3) == 1)
+        {
+            int ix = 0;
+            if (addr & 32) ix |= 1;
+            if ((addr & 8) == 0) ix |= 4;
+            if ((addr & 4) == 0) ix |= 2;
+            uint32_t v;
+            if (s.FifoLookup(false, pcm.select_channel, static_cast<uint8_t>(ix), &v))
+            {
+                pcm.read_latch = v;
+                return 0;
+            }
+        }
+        else if (((addr >= 0x10 && addr < 0x20) || (addr >= 0x30 && addr < 0x38)) && (addr & 1) == 0)
+        {
+            int ix = (addr >> 1) & 7;
+            if (addr & 32) ix |= 8;
+            uint32_t v;
+            if (s.FifoLookup(true, pcm.select_channel, static_cast<uint8_t>(ix), &v))
+            {
+                pcm.read_latch = static_cast<uint16_t>(v);
+                return 0;
+            }
+        }
+    }
+    return PCM_Read(*mcu.pcm, addr);
+}
+
+// Circle dispatch for the 4 PCM call sites in mcu.cpp: skeletal
+// (MK1 only) when the split is active, direct otherwise.
+inline void SplitPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value) {
+    if (g_splitT && mcu.is_mk1)
+        SkelPCMWrite(mcu, addr, value);
+    else
+        PCM_Write(*mcu.pcm, addr, value);
+}
+
+inline uint8_t SplitPCMRead(mcu_t& mcu, uint32_t addr) {
+    if (g_splitT && mcu.is_mk1)
+        return SkelPCMRead(mcu, addr);
+    return PCM_Read(*mcu.pcm, addr);
+}
