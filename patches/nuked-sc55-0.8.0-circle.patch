+                    case 17:
+                        injL = sx20(rcadd[0] >> 1) + (rcadd[0] & 1);
+                        injC1 = sx20(rcadd2[0] >> 1) + (rcadd2[0] & 1);
+                        break;
+                    case 18:
+                        injR = sx20(rcadd[1] >> 1) + (rcadd[1] & 1);
+                        injC1 = sx20(rcadd2[1] >> 1) + (rcadd2[1] & 1);
+                        break;
+                    case 21:
+                        injL = sx20(rcadd[2] >> 1) + (rcadd[2] & 1);
+                        injC0 = sx20(rcadd2[2] >> 1) + (rcadd2[2] & 1);
+                        break;
+                    case 22:
+                        injR = sx20(rcadd[3] >> 1) + (rcadd[3] & 1);
+                        injC1 = sx20(rcadd2[3] >> 1) + (rcadd2[3] & 1);
+                        break;
+                    case 23:
+                        injL = sx20(rcadd[4] >> 1) + (rcadd[4] & 1);
+                        injC0 = sx20(rcadd2[4] >> 1) + (rcadd2[4] & 1);
+                        break;
+                    case 31:
+                        injR = sx20(rcadd[5] >> 1) + (rcadd[5] & 1);
+                        injC1 = sx20(rcadd2[5] >> 1) + (rcadd2[5] & 1);
+                        break;
+                }
+                mix_injL[slot] = injL;
+                mix_injR[slot] = injR;
+                mix_injC0[slot] = injC0;
+                mix_injC1[slot] = injC1;
+            }
+
+            if (key && pcm.nfs)
+            {
+                ram2[7] &= ~0xf020;
+                ram2[7] |= (uint16_t)(((usenew || kon) ? newnibble : old_nibble) << 12);
+
+                // update key
+                ram2[7] |= (uint16_t)(key << 5);
+            }
+
+            if (!active)
+            {
+                if (pcm.nfs)
+                {
+                    ram1[1] = 0;
+                    ram1[3] = 0;
+                    ram1[5] = 0;
+                }
+
+                ram2[8] = 0;
+                ram2[9] = 0;
+                ram2[10] = 0;
+            }
+        }
+        // Cross-slot NEON mix: the mix chain runs in .4s lanes over
+        // groups of 4 slots, so coefficient vectors are loaded from the
+        // contiguous mix_* arrays -- no per-slot packing. Lanes beyond
+        // reg_slots are zero in all arrays and contribute zero terms.
+        // Accumulation is into 4 vector accumulators, combined once
+        // below; by the sx20 homomorphism the combined values are
+        // congruent mod 2^20 to the original serial sums, and every
+        // downstream observation (sx20 reads, write_mask low bits) is
+        // therefore identical.
+        {
+            typedef int int32x4_t __attribute__((vector_size(16)));
+            int32x4_t vaccL = {0, 0, 0, 0};
+            int32x4_t vaccR = {0, 0, 0, 0};
+            int32x4_t vaccC0 = {0, 0, 0, 0};
+            int32x4_t vaccC1 = {0, 0, 0, 0};
+            const int ngroups = (pcm.config.reg_slots + 3) / 4;
+            for (int g = 0; g < ngroups; g++)
+            {
+                const int32_t *pSample = mix_sample + g * 4;
+                const int32_t *pVm1 = mix_vm1 + g * 4;
+                const int32_t *pVm2 = mix_vm2 + g * 4;
+                const int32_t *pPan = mix_pan + g * 4;
+                const int32_t *pRc = mix_rc + g * 4;
+                const int32_t *pInjL = mix_injL + g * 4;
+                const int32_t *pInjR = mix_injR + g * 4;
+                const int32_t *pInjC0 = mix_injC0 + g * 4;
+                const int32_t *pInjC1 = mix_injC1 + g * 4;
+                __asm__ volatile (
+                    // Inputs: q0=sample q1=vm1 q2=vm2 q3=pan q4=rc
+                    // q5=injL q6=injR q7=injC0 q8=injC1. Accumulators
+                    // are the "+w" operands (never hardcode their
+                    // registers); v0-v19/v30/v31 are clobbered scratch.
+                    "ldr q0, [%[pSample]]\n\t"
+                    "ldr q1, [%[pVm1]]\n\t"
+                    "ldr q2, [%[pVm2]]\n\t"
+                    "ldr q3, [%[pPan]]\n\t"
+                    "ldr q4, [%[pRc]]\n\t"
+                    "ldr q5, [%[pInjL]]\n\t"
+                    "ldr q6, [%[pInjR]]\n\t"
+                    "ldr q7, [%[pInjC0]]\n\t"
+                    "ldr q8, [%[pInjC1]]\n\t"
+                    // Broadcast constants (2 insns/group).
+                    "dup v30.4s, %w[c127]\n\t"
+                    "dup v31.4s, %w[c1]\n\t"
+                    // V_s = sx20(sample)
+                    "shl v9.4s, v0.4s, #12\n\t"
+                    "sshr v9.4s, v9.4s, #12\n\t"
+                    // volmul1 bytes: b1hi=(int8)(vm1>>8),
+                    // b1lo=(int8)((vm1>>1)&127)
+                    "sshr v10.4s, v1.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "sshr v11.4s, v1.4s, #1\n\t"
+                    "and v11.16b, v11.16b, v30.16b\n\t"
+                    "mul v12.4s, v9.4s, v10.4s\n\t"
+                    "mul v13.4s, v9.4s, v11.4s\n\t"
+                    // sample2 = sx20(mv1>>6)+sx20(mv2>>13)+cin
+                    "sshr v14.4s, v12.4s, #6\n\t"
+                    "shl v14.4s, v14.4s, #12\n\t"
+                    "sshr v14.4s, v14.4s, #12\n\t"
+                    "sshr v15.4s, v13.4s, #13\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "sshr v16.4s, v13.4s, #12\n\t"
+                    "sshr v17.4s, v12.4s, #5\n\t"
+                    "orr v16.16b, v16.16b, v17.16b\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v14.4s, v14.4s, v15.4s\n\t"
+                    "add v14.4s, v14.4s, v16.4s\n\t"
+                    // volmul2 bytes + multiv3/4
+                    "sshr v10.4s, v2.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "sshr v11.4s, v2.4s, #1\n\t"
+                    "and v11.16b, v11.16b, v30.16b\n\t"
+                    "shl v18.4s, v14.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    "mul v12.4s, v18.4s, v10.4s\n\t"
+                    "mul v13.4s, v18.4s, v11.4s\n\t"
+                    // sample3 (same shape as sample2)
+                    "sshr v14.4s, v12.4s, #6\n\t"
+                    "shl v14.4s, v14.4s, #12\n\t"
+                    "sshr v14.4s, v14.4s, #12\n\t"
+                    "sshr v15.4s, v13.4s, #13\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "sshr v16.4s, v13.4s, #12\n\t"
+                    "sshr v17.4s, v12.4s, #5\n\t"
+                    "orr v16.16b, v16.16b, v17.16b\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v14.4s, v14.4s, v15.4s\n\t"
+                    "add v14.4s, v14.4s, v16.4s\n\t"
+                    // sx20(sample3), shared by pan/rc multis
+                    "shl v18.4s, v14.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    // pan bytes + sampl/sampr
+                    "sshr v10.4s, v3.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "shl v11.4s, v3.4s, #24\n\t"
+                    "sshr v11.4s, v11.4s, #24\n\t"
+                    "mul v12.4s, v18.4s, v10.4s\n\t"
+                    "mul v13.4s, v18.4s, v11.4s\n\t"
+                    // rc bytes + rc0/rc1 (>>5)
+                    "sshr v10.4s, v4.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "shl v11.4s, v4.4s, #24\n\t"
+                    "sshr v11.4s, v11.4s, #24\n\t"
+                    "mul v15.4s, v18.4s, v10.4s\n\t"
+                    "sshr v15.4s, v15.4s, #5\n\t"
+                    "mul v16.4s, v18.4s, v11.4s\n\t"
+                    "sshr v16.4s, v16.4s, #5\n\t"
+                    // termL = sx20(sampl>>6) + ((sampl>>5)&1)
+                    "sshr v17.4s, v12.4s, #6\n\t"
+                    "shl v17.4s, v17.4s, #12\n\t"
+                    "sshr v17.4s, v17.4s, #12\n\t"
+                    "sshr v18.4s, v12.4s, #5\n\t"
+                    "and v18.16b, v18.16b, v31.16b\n\t"
+                    "add v17.4s, v17.4s, v18.4s\n\t"
+                    // termR
+                    "sshr v18.4s, v13.4s, #6\n\t"
+                    "shl v18.4s, v18.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    "sshr v19.4s, v13.4s, #5\n\t"
+                    "and v19.16b, v19.16b, v31.16b\n\t"
+                    "add v18.4s, v18.4s, v19.4s\n\t"
+                    // termC0 = sx20(rc0>>1) + (rc0&1)
+                    "sshr v19.4s, v15.4s, #1\n\t"
+                    "shl v19.4s, v19.4s, #12\n\t"
+                    "sshr v19.4s, v19.4s, #12\n\t"
+                    "and v15.16b, v15.16b, v31.16b\n\t"
+                    "add v19.4s, v19.4s, v15.4s\n\t"
+                    // termC1
+                    "sshr v15.4s, v16.4s, #1\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v15.4s, v15.4s, v16.4s\n\t"
+                    // Accumulate (operand registers, never hardcoded).
+                    "add %[vaccL].4s, %[vaccL].4s, v17.4s\n\t"
+                    "add %[vaccL].4s, %[vaccL].4s, v5.4s\n\t"
+                    "add %[vaccR].4s, %[vaccR].4s, v18.4s\n\t"
+                    "add %[vaccR].4s, %[vaccR].4s, v6.4s\n\t"
+                    "add %[vaccC0].4s, %[vaccC0].4s, v19.4s\n\t"
+                    "add %[vaccC0].4s, %[vaccC0].4s, v7.4s\n\t"
+                    "add %[vaccC1].4s, %[vaccC1].4s, v15.4s\n\t"
+                    "add %[vaccC1].4s, %[vaccC1].4s, v8.4s\n\t"
+                    : [vaccL] "+w" (vaccL), [vaccR] "+w" (vaccR),
+                      [vaccC0] "+w" (vaccC0), [vaccC1] "+w" (vaccC1)
+                    : [pSample] "r" (pSample), [pVm1] "r" (pVm1),
+                      [pVm2] "r" (pVm2), [pPan] "r" (pPan),
+                      [pRc] "r" (pRc), [pInjL] "r" (pInjL),
+                      [pInjR] "r" (pInjR), [pInjC0] "r" (pInjC0),
+                      [pInjC1] "r" (pInjC1), [c127] "r" (127),
+                      [c1] "r" (1)
+                    : "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7",
+                      "v8", "v9", "v10", "v11", "v12", "v13", "v14",
+                      "v15", "v16", "v17", "v18", "v19", "v30", "v31",
+                      "memory");
+            }
+            // Combine: horizontal sums of the 4 lanes. Store the
+            // vectors to the stack once per tick and sum in C (the
+            // per-tick cost is negligible; ADDV would save ~20 insns
+            // per tick and is left as a micro-optimization).
+            int32_t hL[4], hR[4], hC0[4], hC1[4];
+            __asm__ volatile (
+                "st1 {%[vaccL].4s}, [%[hL]]\n\t"
+                "st1 {%[vaccR].4s}, [%[hR]]\n\t"
+                "st1 {%[vaccC0].4s}, [%[hC0]]\n\t"
+                "st1 {%[vaccC1].4s}, [%[hC1]]\n\t"
+                : : [vaccL] "w" (vaccL), [vaccR] "w" (vaccR),
+                    [vaccC0] "w" (vaccC0), [vaccC1] "w" (vaccC1),
+                    [hL] "r" (hL), [hR] "r" (hR),
+                    [hC0] "r" (hC0), [hC1] "r" (hC1)
+                : "memory");
+            pcm.accum_l = hL[0] + hL[1] + hL[2] + hL[3];
+            pcm.accum_r = hR[0] + hR[1] + hR[2] + hR[3];
+            pcm.rcsum[0] = hC0[0] + hC0[1] + hC0[2] + hC0[3];
+            pcm.rcsum[1] = hC1[0] + hC1[1] + hC1[2] + hC1[3];
+            // ram1[31][1]/[3] intentionally left at their pre-loop
+            // zero (unobserved after the tick; see splitacc note).
+        }
+
+        // PMU (shaped-var): voice-mix cycles for this batch,
+        // accumulated PER BATCH (not per tick) to keep read overhead
+        // negligible. NOP-corrected, clamped at 0.
+        if (g_splitT)
+        {
+            const uint64_t nMixDelta = PMU_ReadCycles() - nMixStartCyc;
+            const uint64_t nMixNop = g_splitT->nop_cyc3;
+            g_splitT->mix_cyc = g_splitT->mix_cyc + (nMixDelta >= nMixNop ? nMixDelta - nMixNop : 0);
+        }
+
+        if (pcm.nfs)
+        {
+            pcm.ram2[31][7] |= 0x20;
+        }
+
+        pcm.nfs = true;
+
+        uint64_t new_cycles = (uint64_t)(pcm.config.reg_slots + 1) * 25;
+
+        pcm.cycles += pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles;
+
+        // mt32-pi dual-core split: publish the RenderStep of the tick
+        // that just advanced, so the MCU thread's tick rule can tell
+        // which ticks have rendered. No-op when inactive / JV880.
+        // The advance passed is the actual cycles advanced (JV880
+        // scales it), mirroring the prototype.
+        if (g_splitT)
+            g_splitT->PublishRenderedStep(pcm, pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles);
+    }
+
+    if (nProfileStart)
+    {
+        NukedProfile().nPCMUs += pProfileClock() - nProfileStart;
+        ++NukedProfile().nPCMUpdates;
+    }
+}
+
+// Variant descriptor table (data-driven dispatch, 2026-10-31
+// ~09:39): adding a variant is one table entry + its PCM_Update_*
+// function -- no switch to rewrite. The table now has six entries;
+// minimal.cpp sequence_done fields were extended to match (v4, v5).
+const PCMVariantDesc g_pcmVariants[] = {
+    {0, "baseline", "shaped-diag code path unchanged", PCM_Update},
+    {1, "sched", "round-1 lambda-pair slot loop", PCM_Update_Sched},
+    {2, "pipe", "round-2 head/tail pair split", PCM_Update_Pipe},
+    {3, "neon2", "round-2 NEON mix-tail v2 (no lane inserts, full-width loads)", PCM_Update_Neon2},
+    {4, "splitacc", "round-3 NEON v2 block + even/odd split accumulators", PCM_Update_Splitacc},
+    {5, "layout", "round-3 cross-slot NEON, no per-slot packing", PCM_Update_Layout},
+};
+const int g_pcmVariantCount = sizeof(g_pcmVariants) / sizeof(g_pcmVariants[0]);
+
+// Table-driven dispatcher: linear search by number (4 entries:
+// negligible vs a batch). Unknown numbers fall back to baseline
+// (entry 0), so a stale/corrupt variant can never select a
+// nonexistent path.
+void PCM_Update_Variant(pcm_t& pcm, uint64_t cycles, int variant)
+{
+    for (int i = 0; i < g_pcmVariantCount; ++i)
+    {
+        if (g_pcmVariants[i].number == variant)
+        {
+            g_pcmVariants[i].update(pcm, cycles);
+            return;
+        }
+    }
+    g_pcmVariants[0].update(pcm, cycles);
+}
