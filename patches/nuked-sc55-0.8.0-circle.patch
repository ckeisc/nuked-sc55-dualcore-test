+                           ((uint64_t)(uint32_t)(int8_t)((pan >> 0) & 255) << 32);
+            neon_pack[3] = (uint32_t)(int8_t)((rc >> 8) & 255) |
+                           ((uint64_t)(uint32_t)(int8_t)((rc >> 0) & 255) << 32);
