+        // reg_slots are zero in all arrays and contribute zero terms.
+        // Accumulation is into 4 vector accumulators, combined once
+        // below; by the sx20 homomorphism the combined values are
+        // congruent mod 2^20 to the original serial sums, and every
+        // downstream observation (sx20 reads, write_mask low bits) is
+        // therefore identical.
+        {
+            typedef int int32x4_t __attribute__((vector_size(16)));
+            int32x4_t vaccL = {0, 0, 0, 0};
+            int32x4_t vaccR = {0, 0, 0, 0};
+            int32x4_t vaccC0 = {0, 0, 0, 0};
+            int32x4_t vaccC1 = {0, 0, 0, 0};
+            const int ngroups = (pcm.config.reg_slots + 3) / 4;
+            for (int g = 0; g < ngroups; g++)
+            {
+                const int32_t *pSample = mix_sample + g * 4;
+                const int32_t *pVm1 = mix_vm1 + g * 4;
+                const int32_t *pVm2 = mix_vm2 + g * 4;
+                const int32_t *pPan = mix_pan + g * 4;
+                const int32_t *pRc = mix_rc + g * 4;
+                const int32_t *pInjL = mix_injL + g * 4;
