+                "ldr q1, [%[pack]]\n\t"
+                "ldr q2, [%[pack], #16]\n\t"
+                // vol1: sx20(sample) * [cA, cB] (lanes 0,1 of q1)
+                "dup v0.4s, %w[sample]\n\t"
+                "shl v0.4s, v0.4s, #12\n\t"
+                "sshr v0.4s, v0.4s, #12\n\t"
+                "mul v0.4s, v0.4s, v1.4s\n\t"
+                "umov w10, v0.s[0]\n\t"
+                "umov w11, v0.s[1]\n\t"
+                // sample2 = sx20(m1>>6) + sx20(m2>>13) + cin
+                "asr w14, w11, #12\n\t"
+                "asr w15, w10, #5\n\t"
+                "orr w14, w14, w15\n\t"
+                "and w14, w14, #1\n\t"
+                "sbfx w15, w10, #6, #20\n\t"
+                "sbfx w16, w11, #13, #19\n\t"
+                "add w17, w15, w16\n\t"
+                "add w17, w17, w14\n\t"
+                // vol2: sx20(sample2) * [cC, cD] (lanes 2,3 of q1)
+                "dup v0.4s, w17\n\t"
+                "shl v0.4s, v0.4s, #12\n\t"
+                "sshr v0.4s, v0.4s, #12\n\t"
+                "mul v0.4s, v0.4s, v1.4s\n\t"
+                "umov w12, v0.s[2]\n\t"
+                "umov w13, v0.s[3]\n\t"
+                // sample3
+                "asr w14, w13, #12\n\t"
+                "asr w15, w12, #5\n\t"
+                "orr w14, w14, w15\n\t"
+                "and w14, w14, #1\n\t"
+                "sbfx w15, w12, #6, #20\n\t"
+                "sbfx w16, w13, #13, #19\n\t"
+                "add w18, w15, w16\n\t"
+                "add w18, w18, w14\n\t"
+                // pan/rc: sx20(sample3) * [panHi, panLo, rcHi, rcLo]
+                "dup v0.4s, w18\n\t"
+                "shl v0.4s, v0.4s, #12\n\t"
+                "sshr v0.4s, v0.4s, #12\n\t"
+                "mul v0.4s, v0.4s, v2.4s\n\t"
+                "umov %w[sampl], v0.s[0]\n\t"
+                "umov %w[sampr], v0.s[1]\n\t"
+                "umov %w[rc0raw], v0.s[2]\n\t"
+                "umov %w[rc1raw], v0.s[3]\n\t"
+                : [sampl] "=r" (sampl), [sampr] "=r" (sampr),
+                  [rc0raw] "=r" (rc0raw), [rc1raw] "=r" (rc1raw)
+                : [sample] "r" (sample), [pack] "r" (neon_pack)
+                : "x10", "x11", "x12", "x13", "x14", "x15", "x16",
+                  "x17", "x18", "v0", "v1", "v2", "memory");
