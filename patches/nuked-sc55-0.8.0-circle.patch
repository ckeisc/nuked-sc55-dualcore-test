+#pragma once
+
+// mt32-pi diagnostics profiling (not part of upstream Nuked-SC55).
+//
+// Coarse phase accounting for the optimization work: wall time inside
+// Emulator::Step split into PCM rendering vs everything else (H8
+// instruction execution, timers, UART, analog), plus the executed
+// instruction count. A host installs a microsecond clock to enable it;
+// with no clock installed (the default) every seam costs one predictable
+// branch and accumulates nothing.
+
+#include <cstdint>
+
+struct NukedProfileData
+{
+    uint64_t nTotalUs      = 0; // wall time inside Emulator::Step
+    uint64_t nPCMUs        = 0; // wall time inside rendering PCM_Update calls
+    uint64_t nInstructions = 0; // H8 instructions executed
+    uint64_t nPCMUpdates   = 0; // PCM_Update calls that rendered >= 1 tick
+};
+
+using NukedProfileClockFn = uint64_t (*)();
+
+void NukedProfileSetClock(NukedProfileClockFn pFn);
+// Inline accessor (round 3): MCU_StepMCU consults this every step, so
+// it must not be an out-of-line call.
+extern NukedProfileClockFn g_nukedProfileClockFn;
+inline NukedProfileClockFn NukedProfileClock()
+{
+    return g_nukedProfileClockFn;
+}
+NukedProfileData& NukedProfile();
