+            uint64_t neon_pack[4] __attribute__((aligned(16)));
+            neon_pack[0] = (uint32_t)(int8_t)(volmul1 >> 8) |
+                           ((uint64_t)(uint32_t)(int8_t)((volmul1 >> 1) & 127) << 32);
+            neon_pack[1] = (uint32_t)(int8_t)(volmul2 >> 8) |
+                           ((uint64_t)(uint32_t)(int8_t)((volmul2 >> 1) & 127) << 32);
