+
+/*
+ * split_thread_circle.h -- skeletal JV880-shape sync for the mt32-pi
+ * minimal validity kernel (Sterr1/Mini-JV880pi shape, adapted).
+ *
+ * This REPLACES the timestamped-FIFO + RPC split that wedged on
+ * hardware (core 2 in RPC-wait, core 3 stuck in the RPC claim
+ * Acquire, with the Circle sev fix present). Everything the old
+ * header did is gone: no write FIFO, no IRQ FIFO, no RPC
+ * back-channel, no shadows, no tick rule, no lookahead bound.
+ * The MCU core never waits on the PCM core for anything, and the
+ * PCM core never waits on the MCU core for anything except the
+ * published cycle count (an atomic load, never blocking).
+ *
+ * The shape, mirrored from Sterr1 (minijv880.cpp Run, mcu.h
+ * MCU_PostSample, pcm.cpp PCM_Write/PCM_Read lock scopes):
+ * - SHARED pcm state: both cores use the SAME pcm_t in memory.
+ *   MCU_Write writes registers DIRECTLY into it; MCU_Read reads
+ *   DIRECTLY from it. No shadows for live reads.
+ * - CYCLE-COUNT PUBLISH: core 2 RELEASE-stores mcu.cycles after
+ *   every MCU step (StepMCU = one instruction, so this is
+ *   per-instruction publish, exactly Sterr1's granularity). Core 3
+ *   ACQUIRE-loads it and renders ONLY up to that target, never
+ *   beyond. The RELEASE/ACQUIRE pair is the happens-before edge
+ *   that makes the direct reads valid: every register write the
+ *   MCU made before publishing cycle C is visible to any core
+ *   that ACQUIRE-loads a count >= C.
+ * - CORE-3 BATCHES: bounded (128 ticks = Sterr1's 128 samples:
+ *   this backend renders one sample per tick at native rate),
+ *   each batch under the state lock, idle-wait via the ARM
+ *   yield-hint pause (SplitPause -- this kernel registers no
+ *   CScheduler tasks, so Yield() can never return, and wfe is
+ *   never used for a wait here).
+ * - STATE LOCK: one CSpinLock (WITH Circle's sev fix, as in the
+ *   sevfix tree) for the hot path, exactly as in Sterr1: single
+ *   RAM-store holds on the MCU side, whole-batch holds on the
+ *   PCM side. See SkelPCMWrite/SkelPCMRead for the exact scopes.
+ * - NO OVERSHOOT: the batch target passed to PCM_Update is capped
+ *   at (published - 800). A tick is at most 800 cycles
+ *   ((reg_slots+1)*25, reg_slots <= 31), and PCM_Update renders
+ *   the tick that crosses its target, so capping at published-800
+ *   guarantees no tick ever ends past the published cycle count.
+ *   Core 3 therefore lags published by at most ~800 cycles
+ *   (~2 samples typical, ~16 at boot tick size) -- negligible
+ *   against the 16384-frame sample ring.
+ *
+ * Deviations from Sterr1, all deliberate and documented here:
+ * (1) Write-lock scope: Sterr1 holds pcm_lock for the single RAM
+ *     store only; the latch accumulation happens outside the lock.
+ *     Our backend's PCM_Write fuses latch accumulation and the
+ *     store in one function, so splitting them would duplicate
+ *     backend logic. SkelPCMWrite therefore holds the state lock
+ *     for the WHOLE PCM_Write call, but ONLY for writes that
+ *     actually commit a store (ram1 iff (addr&3)==3, ram2 iff
+ *     (addr&1)==1, ranges per backend pcm.cpp PCM_Write). The
+ *     latch state (write_latch) is core-2-only -- every use is
+ *     inside PCM_Write, core 3 never touches it -- so holding
+ *     the lock across the latch ops changes nothing semantically
+ *     and costs a few integer ops. Which writes take the lock
+ *     matches Sterr1 exactly.
+ * (2) Idle-wait: SplitPause (ARM yield hint) instead of Sterr1's
+ *     CTimer::SimpleMsDelay(0). This kernel's spin waits all use
+ *     the yield hint (no CScheduler tasks exist), and the task
+ *     specifies it.
+ * (3) Publish point: after StepMCU, before StepPeripherals.
+ *     Sterr1 publishes right after the cycles increment, before
+ *     TIMER_Clock/UART/analog -- the same order: StepMCU ends
+ *     with cycles += 12, and the peripherals do not touch pcm_t.
+ * (4) IRQ delivery: the voice-end assert takes the direct
+ *     MCU_Interrupt_SetRequest(IRQ0, 1) path (pcm.cpp assert site;
+ *     the old FIFO branch was deleted with the FIFO), as Sterr1
+ *     sets its GA line directly from the PCM core. The assert-set
+ *     (core 3, under
+ *     the state lock during a batch) and the status-read ACK
+ *     clear (core 2, under the state lock) are serialized by the
+ *     lock; MCU_Interrupt_Handle only READS interrupt_pending
+ *     (it never Excludes from it), so no unlocked RMW races the
+ *     locked writers.
+ * (5) Sample ring: Sterr1's ring lives in the app (MCU_PostSample
+ *     + core-2 drain), not in this header. This kernel's ring is
+ *     include/ring.h (SkelRing), which mirrors Sterr1's
+ *     discipline exactly (monotonic uint64 indices, modulo slots,
+ *     drop-oldest with a counter, RELEASE publish / ACQUIRE
+ *     consume) -- including its drop-path property: when the ring
+ *     is full, a concurrent consumer dequeue can make the
+ *     producer's drop store move read_idx backward by a few
+ *     slots, re-delivering already-consumed frames. That only
+ *     fires when the ring is full, and the pass bar requires
+ *     ring_drops == 0 (never full), so it cannot affect a clean
+ *     run; it is inherited from Sterr1, not introduced here.
+ *
+ * No-op stubs (DrainBeforeTick / PublishRenderedStep / DrainIrq)
+ * exist ONLY because backend pcm.cpp / emu.cpp still call those
+ * hooks; the skeletal flow never needs them (shared state needs
+ * no draining, no RenderStep publication, no IRQ back-channel).
+ * They compile to nothing and must stay no-ops.
+ *
+ * Scope: MK1 only, as before. The dispatch bypasses to the direct
+ * path for any non-MK1 model, and the kernel only activates the
+ * split for MK1 romsets.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <utility>
+
+#include <circle/sched/scheduler.h>
+#include <circle/spinlock.h>
+#include <circle/synchronize.h>
+#include <circle/timer.h>
+
+#include "mcu.h"
+#include "mcu_interrupt.h"
+#include "pcm.h"
+
+// Local cross-core barrier. Circle's DataMemBarrier() expands to bare
+// "dmb", which the AArch64 assembler rejects (an option operand is
+// required on AArch64; bare dmb/dsb are ARMv7 forms). "dmb ish" is
+// the inner-shareable barrier -- the right domain for visibility
+// between cores of one SoC -- and is what every DataMemBarrier()
+// call site below actually needs.
+static inline void SplitDMB()
+{
+    __asm__ volatile ("dmb ish" ::: "memory");
+}
+// Scheduler-free pause: this kernel registers no CScheduler tasks,
+// so Yield() can never return. ARM YIELD hint.
+static inline void SplitPause()
+{
+    __asm__ volatile ("yield" ::: "memory");
+}
+
+// PMU cycle-counter read (FFmpeg checkasm port): isb, then read the
+// per-core 64-bit cycle counter. Used by the app's core loops AND
+// by the backend (Skel lock timing, PCM_Update mix bracketing), so
+// it lives here. At 1 GHz the 64-bit counter cannot wrap inside a
+// window. If the counter was never enabled (or failed validation),
+// it reads stuck and every derived delta is 0 -- never a valid
+// nonzero value, which is why the boot line's pmc2/pmc3 is the
+// validity signal for the cycle fields.
+static inline uint64_t PMU_ReadCycles()
+{
+    uint64_t nCycles = 0;
+    __asm__ volatile ("isb; mrs %0, pmccntr_el0" : "=r" (nCycles));
+    return nCycles;
+}
+
+// Variant descriptor table (data-driven dispatch): number, short
+// name, full name, and PCM_Update implementation. Defined in pcm.cpp
+// (where the implementations live); the app reads names + count
+// from it, so adding a variant is one table entry + its function --
+// no switch to rewrite in either file.
+struct PCMVariantDesc {
+    int number;
+    const char* short_name;
+    const char* full_name;
+    void (*update)(pcm_t& pcm, uint64_t cycles);
+};
+extern const PCMVariantDesc g_pcmVariants[];
+extern const int g_pcmVariantCount;
+
+// Table-driven dispatcher (defined in pcm.cpp): looks the variant
+// number up in g_pcmVariants and calls its implementation. All
+// variants share the same pcm_t state; only the compute path
+// changes. Unknown numbers fall back to baseline (entry 0).
+void PCM_Update_Variant(pcm_t& pcm, uint64_t cycles, int variant);
+
+struct ThreadSplitStateCircle;
+
+// Owned by the app (CMinimalApp): set when the split is activated
+// (after priming / on reset, with the PCM task stopped), cleared on
+// teardown so a stale state can never dispatch.
+extern ThreadSplitStateCircle* g_splitT;
+
+struct ThreadSplitStateCircle {
+    // The one hot-path lock (CSpinLock WITH the Circle sev fix).
+    // MCU side: held for a committing RAM store only (see
+    // SkelPCMWrite) or a brief status computation (see SkelPCMRead).
+    // PCM side: held for each whole render batch.
+    CSpinLock state_lock;
+
+    // Published MCU cycle count. Plain field, accessed ONLY via
+    // __atomic builtins cross-core: core 2 stores with RELEASE
+    // after each StepMCU, core 3 loads with ACQUIRE. (InitFromPCM
+    // stores plainly: single-threaded context, before the state
+    // is published with DMBs by the app.)
+    uint64_t cycles_pub{0};
+
+    // Batch discipline (see the header comment): a tick is at most
+    // (31+1)*25 = 800 cycles, and a batch renders at most 128 ticks
+    // (Sterr1's 128-sample bound; one tick = one sample here).
+    static constexpr uint64_t MaxTickCycles = 800;
+    static constexpr uint64_t MaxBatchTicks = 128;
+
+    // Render position + stats (core 3 writes, core 2 reads; single
+    // writer each, volatile + DMB as in the old header). pcm_rendered
+    // is STATS ONLY now -- core 2 waits on nothing.
+    volatile uint64_t pcm_rendered{0};
+    volatile uint64_t pcm_task_us{0};
+    volatile uint64_t max_pcm_lag{0};
+
+    // DIAG (shaped-diag only): core-2 state-lock spin waits.
+    // Written ONLY by the MCU thread (core 2) in
+    // SkelPCMWrite/SkelPCMRead; read by core 2's window writer.
+    // Core 3's batch holds are NOT counted here (they are what
+    // core 2 waits ON). Two CTimer reads per lock op add ns-scale
+    // overhead to the hot path -- diagnostic only, never shipped.
+    volatile uint64_t lock_wait_us{0};
+    volatile uint64_t lock_waits{0};
+
+    // PMU (shaped-var only): cumulative cycle counters, same delta
+    // discipline as the _us counters (the app snapshots them per
+    // window; InitFromPCM deliberately does NOT reset them, exactly
+    // like lock_wait_us/lock_waits -- the window snapshots stay
+    // consistent across the reset inside DoVariantAdvance).
+    // pcm_task_cyc: core-3 total PCM task work (same scope as
+    // pcm_task_us). mix_cyc: core-3 voice-mix portion, accumulated
+    // PER BATCH inside the PCM_Update variants (not per tick, to
+    // keep read overhead negligible). lock_wait_cyc: core-2
+    // state-lock spin cycles, NOP-corrected per op at accumulation
+    // (see SkelPCMWrite/SkelPCMRead). nop_cyc2/nop_cyc3: each
+    // core's back-to-back double-read cost, measured once at loop
+    // start, NEVER reset (not per-activation data).
+    volatile uint64_t pcm_task_cyc{0};
+    volatile uint64_t mix_cyc{0};
+    volatile uint64_t lock_wait_cyc{0};
+    volatile uint64_t nop_cyc2{0};
+    volatile uint64_t nop_cyc3{0};
+
+    // No-op stubs for the backend hooks (see the header comment).
+    // pcm.cpp's tick hook and end hook, and emu.cpp's SplitDrainIrq,
+    // still call these; they must do nothing.
+    void DrainBeforeTick(pcm_t&) {
+    }
+
+    void PublishRenderedStep(pcm_t&, uint64_t) {
+    }
+
+    void DrainIrq(mcu_t&) {
+    }
+
+    // (Re)initialize from a live pcm_t after single-threaded priming
+    // or an emulator reset. The caller guarantees the PCM task is
+    // stopped (app handshake) and the MCU thread is not stepping,
+    // so no barrier is needed here; the app issues DMBs before
+    // publishing g_splitT.
+    void InitFromPCM(pcm_t& pcm, mcu_t& mcu) {
+        cycles_pub = (uint64_t)mcu.cycles;
+        pcm_rendered = pcm.cycles;
+        pcm_task_us = 0;
+        max_pcm_lag = 0;
+    }
+};
+
+// MCU thread: direct register write into shared pcm state, with the
+// state lock held ONLY for a committing RAM store (Sterr1's scope;
+// see the header comment for the fused-latch sub-deviation).
+// Ranges and commit bits are backend pcm.cpp PCM_Write verbatim:
+// ram1 (0x04-0x10, 0x24-0x30) commits iff (addr&3)==3;
+// ram2 (0x10-0x20, 0x30-0x38) commits iff (addr&1)==1.
+// All other addresses (voice mask, wave ROM, config) never store
+// and never take the lock -- exactly as in Sterr1.
+inline void SkelPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value) {
+    addr &= 0x3f;
+    const bool bCommits =
+        ((((addr >= 0x04 && addr < 0x10) || (addr >= 0x24 && addr < 0x30)) && ((addr & 3) == 3)) ||
+         (((addr >= 0x10 && addr < 0x20) || (addr >= 0x30 && addr < 0x38)) && ((addr & 1) == 1)));
+    if (bCommits) {
+        ThreadSplitStateCircle& s = *g_splitT;
+        const uint64_t t0 = CTimer::GetClockTicks();
+        const uint64_t c0 = PMU_ReadCycles();
+        s.state_lock.Acquire();
+        s.lock_wait_us = s.lock_wait_us + (CTimer::GetClockTicks() - t0);
+        const uint64_t cDelta = PMU_ReadCycles() - c0;
+        const uint64_t cNop = s.nop_cyc2;
+        s.lock_wait_cyc = s.lock_wait_cyc + (cDelta >= cNop ? cDelta - cNop : 0);
+        s.lock_waits = s.lock_waits + 1;
+        PCM_Write(*mcu.pcm, addr, value);
+        s.state_lock.Release();
+    } else {
+        PCM_Write(*mcu.pcm, addr, value);
+    }
+}
+
+// MCU thread: direct read from shared pcm state. Status reads
+// (0x3c/0x3e, including the IRQ-ack clear) hold the state lock for
+// the brief status computation only -- Sterr1's scope exactly.
+// 0x3f (wave latch), voice RAM reads, latch bytes and mask commits
+// run unlocked, exactly as in Sterr1.
+inline uint8_t SkelPCMRead(mcu_t& mcu, uint32_t addr) {
+    addr &= 0x3f;
+    if (addr == 0x3c || addr == 0x3e) {
+        ThreadSplitStateCircle& s = *g_splitT;
+        const uint64_t t0 = CTimer::GetClockTicks();
+        const uint64_t c0 = PMU_ReadCycles();
+        s.state_lock.Acquire();
+        s.lock_wait_us = s.lock_wait_us + (CTimer::GetClockTicks() - t0);
+        const uint64_t cDelta = PMU_ReadCycles() - c0;
+        const uint64_t cNop = s.nop_cyc2;
+        s.lock_wait_cyc = s.lock_wait_cyc + (cDelta >= cNop ? cDelta - cNop : 0);
+        s.lock_waits = s.lock_waits + 1;
+        uint8_t value = PCM_Read(*mcu.pcm, addr);
+        s.state_lock.Release();
+        return value;
+    }
+    return PCM_Read(*mcu.pcm, addr);
+}
+
+// Circle dispatch for the 4 PCM call sites in mcu.cpp: skeletal
+// (MK1 only) when the split is active, direct otherwise. No
+// interleaved branch exists on device.
+inline void SplitPCMWrite(mcu_t& mcu, uint32_t addr, uint8_t value) {
+    if (g_splitT && mcu.is_mk1)
+        SkelPCMWrite(mcu, addr, value);
+    else
+        PCM_Write(*mcu.pcm, addr, value);
+}
+
+inline uint8_t SplitPCMRead(mcu_t& mcu, uint32_t addr) {
+    if (g_splitT && mcu.is_mk1)
+        return SkelPCMRead(mcu, addr);
+    return PCM_Read(*mcu.pcm, addr);
+}
