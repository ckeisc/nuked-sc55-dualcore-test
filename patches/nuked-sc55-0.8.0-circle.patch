+            int rc1 = rc1raw >> 5; // chorus
+#else
+            int multiv1 = multi(sample, (int8_t)(volmul1 >> 8));
+            int multiv2 = multi(sample, (int8_t)((volmul1 >> 1) & 127));
+
+            int sample2 = addclip20(multiv1 >> 6, multiv2 >> 13, ((multiv2 >> 12) | (multiv1 >> 5)) & 1);
+
+            int multiv3 = multi(sample2, (int8_t)(volmul2 >> 8));
+            int multiv4 = multi(sample2, (int8_t)((volmul2 >> 1) & 127));
+
+            int sample3 = addclip20(multiv3 >> 6, multiv4 >> 13, ((multiv4 >> 12) | (multiv3 >> 5)) & 1);
+
+            int sampl = multi(sample3, (int8_t)((pan >> 8) & 255));
+            int sampr = multi(sample3, (int8_t)((pan >> 0) & 255));
+
+            int rc0 = multi(sample3, (int8_t)((rc >> 8) & 255)) >> 5; // reverb
+            int rc1 = multi(sample3, (int8_t)((rc >> 0) & 255)) >> 5; // chorus
+#endif
+            
+            // Split accumulation: this slot's mix terms plus its slot2
+            // injection terms (same mapping as the original two switches,
+            // merged into one) go to the even/odd accumulator pair.
+            // The running-sum sx20 wrap is deferred to the combine
+            // below; by the sx20 homomorphism the combined value is
+            // congruent mod 2^20 to the original serial sum, and every
+            // downstream observation (sx20 reads, write_mask low bits)
+            // is therefore identical.
+            int32_t tL = sx20(sampl >> 6) + ((sampl >> 5) & 1);
+            int32_t tR = sx20(sampr >> 6) + ((sampr >> 5) & 1);
+            int32_t tC0 = sx20(rc0 >> 1) + (rc0 & 1);
+            int32_t tC1 = sx20(rc1 >> 1) + (rc1 & 1);
+            int slot2 = (slot == pcm.config.reg_slots - 1) ? 31 : slot + 1;
+            switch (slot2)
+            {
+                // 17, 18 - reverb
+                case 17:
+                    tL += sx20(rcadd[0] >> 1) + (rcadd[0] & 1);
+                    tC1 += sx20(rcadd2[0] >> 1) + (rcadd2[0] & 1);
+                    break;
+                case 18:
+                    tR += sx20(rcadd[1] >> 1) + (rcadd[1] & 1);
+                    tC1 += sx20(rcadd2[1] >> 1) + (rcadd2[1] & 1);
+                    break;
+                case 21:
+                    tL += sx20(rcadd[2] >> 1) + (rcadd[2] & 1);
+                    tC0 += sx20(rcadd2[2] >> 1) + (rcadd2[2] & 1);
+                    break;
+                case 22:
+                    tR += sx20(rcadd[3] >> 1) + (rcadd[3] & 1);
+                    tC1 += sx20(rcadd2[3] >> 1) + (rcadd2[3] & 1);
+                    break;
+                case 23:
+                    tL += sx20(rcadd[4] >> 1) + (rcadd[4] & 1);
+                    tC0 += sx20(rcadd2[4] >> 1) + (rcadd2[4] & 1);
+                    break;
+                case 31:
+                    tR += sx20(rcadd[5] >> 1) + (rcadd[5] & 1);
+                    tC1 += sx20(rcadd2[5] >> 1) + (rcadd2[5] & 1);
+                    break;
+            }
+            // Single predictable branch (alternating parity) for all
+            // four accumulators; keeps them in registers, no bus
+            // load/store per slot, no 32-deep serial chain.
+            if (slot & 1)
+            {
+                accL1 += tL;
+                accR1 += tR;
+                accC01 += tC0;
+                accC11 += tC1;
+            }
+            else
+            {
+                accL0 += tL;
+                accR0 += tR;
+                accC00 += tC0;
+                accC10 += tC1;
+            }
+
+            if (key && pcm.nfs)
+            {
+                ram2[7] &= ~0xf020;
+                ram2[7] |= (uint16_t)(((usenew || kon) ? newnibble : old_nibble) << 12);
+
+                // update key
+                ram2[7] |= (uint16_t)(key << 5);
+            }
+
+            if (!active)
+            {
+                if (pcm.nfs)
+                {
+                    ram1[1] = 0;
+                    ram1[3] = 0;
+                    ram1[5] = 0;
+                }
+
+                ram2[8] = 0;
+                ram2[9] = 0;
+                ram2[10] = 0;
+            }
+        }
+
+        // Combine: exact partial sums -> accum/rcsum. Congruent mod
+        // 2^20 to the original serial sums (sx20 homomorphism), so all
+        // downstream observations are identical. ram1[31][1]/[3] are
+        // intentionally left at their pre-loop zero: the bus value is
+        // unobserved after the tick (zeroed pre-loop next tick; the
+        // only in-tick reader was the replaced accumulation) and the
+        // state hash excludes pcm_t.
+        pcm.accum_l = accL0 + accL1;
+        pcm.accum_r = accR0 + accR1;
+        pcm.rcsum[0] = accC00 + accC01;
+        pcm.rcsum[1] = accC10 + accC11;
+        // PMU (shaped-var): voice-mix cycles for this batch,
+        // accumulated PER BATCH (not per tick) to keep read overhead
+        // negligible. NOP-corrected, clamped at 0.
+        if (g_splitT)
+        {
+            const uint64_t nMixDelta = PMU_ReadCycles() - nMixStartCyc;
+            const uint64_t nMixNop = g_splitT->nop_cyc3;
+            g_splitT->mix_cyc = g_splitT->mix_cyc + (nMixDelta >= nMixNop ? nMixDelta - nMixNop : 0);
+        }
+
+        if (pcm.nfs)
+        {
+            pcm.ram2[31][7] |= 0x20;
+        }
+
+        pcm.nfs = true;
+
+        uint64_t new_cycles = (uint64_t)(pcm.config.reg_slots + 1) * 25;
+
+        pcm.cycles += pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles;
+
+        // mt32-pi dual-core split: publish the RenderStep of the tick
+        // that just advanced, so the MCU thread's tick rule can tell
+        // which ticks have rendered. No-op when inactive / JV880.
+        // The advance passed is the actual cycles advanced (JV880
+        // scales it), mirroring the prototype.
+        if (g_splitT)
+            g_splitT->PublishRenderedStep(pcm, pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles);
+    }
+
+    if (nProfileStart)
+    {
+        NukedProfile().nPCMUs += pProfileClock() - nProfileStart;
+        ++NukedProfile().nPCMUpdates;
+    }
+}
+#undef NEON_MIX_TAIL_V2
+
+void PCM_Update_Layout(pcm_t& pcm, uint64_t cycles)
+{
+    // mt32-pi profiling: only calls that will render at least one tick
+    // take clock readings, so the common no-op call costs one comparison.
+    const NukedProfileClockFn pProfileClock = NukedProfileClock();
+    const uint64_t nProfileStart = (pProfileClock && pcm.cycles < cycles) ? pProfileClock() : 0;
+
+    while (pcm.cycles < cycles)
+    {
+        // mt32-pi dual-core split: apply the register writes (and IRQ-ACK
+        // clears) due before this tick, in step order. No-op when the
+        // split is inactive (g_splitT null) or for JV880 (bypassed).
+        if (g_splitT)
+            g_splitT->DrainBeforeTick(pcm);
+
+        const uint32_t voice_active = pcm.voice_mask & pcm.voice_mask_pending;
