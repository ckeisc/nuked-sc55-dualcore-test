+            // A read from both (exercises materialize-on-read and the
+            // status_rd / tempreg side effects); values must agree.
+            const uint32_t r2 = rng.Next();
+            uint8_t va, vb;
+            if (r2 & 1)
+            {
+                const uint32_t addr = frt_addr_base + 16 * ((r2 >> 1) % 3) + ((r2 >> 3) % 10);
+                va = TIMER_ReadFRT(a, addr);
+                vb = TIMER_ReadFRT(b, addr);
+            }
+            else
+            {
+                const uint32_t addr = DEV_TMR_TCR + ((r2 >> 1) % 5);
+                va = TIMER_ReadTMR(a, addr);
+                vb = TIMER_ReadTMR(b, addr);
+            }
+            if (va != vb)
+                mismatches++;
+        }
+
+        cycles += 12;
+        const uint64_t attention_before = b.next_attention;
+        TIMER_Clock(a, cycles);
+        TIMER_Clock(b, cycles);
+
+        if (a.req_mask != b.req_mask)
+            mismatches++;
+        if (sinkA != sinkB)
+            mismatches++;
+
+        // Emulate the MCU taking a pending interrupt (Exclude) and, most
+        // of the time, its ISR acknowledging the flag the way the firmware
+        // does: read TCSR (which arms status_rd), then write TCSR with that
+        // flag bit cleared. Without the acknowledge the flag stays set, the
+        // (enable && flag) pair forces the legacy-exact slow path on every
+        // call, and the lazy fast path would never be exercised. Some
+        // takes deliberately skip the acknowledge so the re-issue path
+        // (flag still set -> request re-asserted next tick) is covered too.
+        if ((r % 13u) == 0u && sinkA != 0u)
+        {
+            const uint32_t lowest = sinkA & (0u - sinkA);
+            sinkA &= ~lowest;
+            sinkB &= ~lowest;
+            if ((r % 5u) != 0u)
+            {
+                const uint32_t src = (uint32_t)__builtin_ctz(lowest);
+                uint32_t addr = 0; uint8_t flag = 0; bool is_frt = false;
+                if (src >= INTERRUPT_SOURCE_FRT0_ICI && src <= INTERRUPT_SOURCE_FRT2_FOVI)
+                {
+                    const uint32_t t = (src - INTERRUPT_SOURCE_FRT0_ICI) / 4;
+                    const uint32_t k = (src - INTERRUPT_SOURCE_FRT0_ICI) % 4; // 0 ICI, 1 OCIA, 2 OCIB, 3 FOVI
+                    addr = frt_addr_base + 16 * t + REG_TCSR;
+                    flag = (k == 1) ? (uint8_t)FRT_TCSR_OCFA : (k == 2) ? (uint8_t)FRT_TCSR_OCFB : (k == 3) ? (uint8_t)FRT_TCSR_OVF : (uint8_t)FRT_TCSR_ICF;
+                    is_frt = true;
+                }
+                else if (src == INTERRUPT_SOURCE_TIMER_CMIA || src == INTERRUPT_SOURCE_TIMER_CMIB || src == INTERRUPT_SOURCE_TIMER_OVI)
+                {
+                    addr = DEV_TMR_TCSR;
+                    flag = (src == INTERRUPT_SOURCE_TIMER_CMIA) ? (uint8_t)TMR_TCSR_CMFA : (src == INTERRUPT_SOURCE_TIMER_CMIB) ? (uint8_t)TMR_TCSR_CMFB : (uint8_t)TMR_TCSR_OVF;
+                }
+                if (flag != 0)
+                {
+                    uint8_t va, vb;
+                    if (is_frt)
+                    {
+                        va = TIMER_ReadFRT(a, addr);
+                        vb = TIMER_ReadFRT(b, addr);
+                    }
+                    else
+                    {
+                        va = TIMER_ReadTMR(a, addr);
+                        vb = TIMER_ReadTMR(b, addr);
+                    }
+                    if (va != vb)
+                        mismatches++;
+                    // Keep the low (control) nibble, keep every other flag
+                    // set (= not acknowledged), clear only this flag.
+                    const uint8_t data = (uint8_t)((va & 0x0f) | (0xf0 & ~flag));
+                    if (is_frt)
+                    {
+                        TIMER_WriteFRT(a, addr, data);
+                        TIMER_WriteFRT(b, addr, data);
+                    }
+                    else
+                    {
+                        TIMER_WriteTMR(a, addr, data);
+                        TIMER_WriteTMR(b, addr, data);
+                    }
+                }
+            }
+        }
+
+        // Full state comparison whenever the lazy side materialized on
+        // its own this step (attention reached, or a read/write above)
+        // and, forced, every 256 steps -- the same cadence as CHECK
+        // mode, so long skip runs are exercised AND verified. The
+        // req_mask / sink comparison above catches a mis-timed event at
+        // its exact step; this catches counter/flag divergence.
+        const bool materialized = (b.cycles >= attention_before) || ((r % 97u) == 0u) || ((r % 61u) == 0u) || ((r % 13u) == 0u);
+        if (materialized || (step & 255u) == 0u)
+        {
+            MaterializeAll(b, b.cycles);
+            if (CompareState(a, b) != TIMER_CHECK_OK)
+                mismatches++;
+        }
+    }
+
+    // The test must also prove that the LAZY fast path engaged: a lazy
+    // timer that materializes every call trivially agrees with legacy
+    // and would validate nothing. Expect at least one skipped call per
+    // 8 steps over this sequence (events are hundreds of ticks apart).
+    if (b.lazy_skips < steps / 8)
+        mismatches++;
+
+    delete pA;
+    delete pB;
+    return mismatches;
 }
