+            const bool nibble_cmp1 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 2
+            bool irq_flag = 0;
+
+            // fixme:
+            if (kon)
+                irq_flag = ((cmp1 + address_loop) & 0x100000) != 0;
+            else
+                irq_flag = ((address + ((-address_loop) & 0xfffff)) & 0x100000) != 0;
+            irq_flag ^= b7;
+
+            int nibble_address = (!b6 && nibble_cmp1) ? address_loop : address; // 3
+            const bool address_b4 = (nibble_address & 0x10) != 0;
+            int wave_address = nibble_address >> 5;
+            const bool xor2 = (address_b4 ^ b7);
+            const bool check1 = xor2 && active;
+            const bool xor1 = (b15 ^ !nibble_cmp1);
+            const bool nibble_add = b6 ? check1 && xor1 : (!nibble_cmp1 && check1);
+            const bool nibble_subtract = b6 && !xor1 && active && !xor2;
+            if (b7)
+                wave_address -= nibble_add - nibble_subtract;
+            else
+                wave_address += nibble_add - nibble_subtract;
+            wave_address &= 0xfffff;
+
+            int newnibble = PCM_RomFetch(pcm, rombanks, hiaddr, (uint32_t)(wave_address));
+            const bool newnibble_sel = address_b4 ^ ((b6 || !nibble_cmp1) && okey);
+            if (newnibble_sel)
+                newnibble = (newnibble >> 4) & 15;
+            else
+                newnibble &= 15;
+
+            int sub_phase = (ram2[8] & 0x3fff); // 1
+            int interp_ratio = (sub_phase >> 7) & 127;
+            sub_phase += pcm.ram2[ram2[7] & 31][0]; // 5
+            int sub_phase_of = (sub_phase >> 14) & 7;
+            if (pcm.nfs)
+            {
+                ram2[8] &= ~0x3fff;
+                ram2[8] |= sub_phase & 0x3fff;
+            }
+
+
+            // address 0
+            int address_cnt = address;
+            int samp0 = (int8_t)PCM_RomFetch(pcm, rombanks, hiaddr, (uint32_t)(address_cnt)); // 18
+
+            cmp1 = address;
+            cmp2 = address_cnt;
+            const bool nibble_cmp2 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 8
+            cmp1 = b15 ? address_loop : address_end;
+            cmp2 = address_cnt;
+            bool address_cmp = (cmp1 & 0xfffff) == (cmp2 & 0xfffff); // 9
+
+            int next_address = address_cnt; // 11
+            bool usenew = !nibble_cmp2;
+            bool next_b15 = b15;
+
+            cmp1 = (!b6 && address_cmp) ? address_loop : address_cnt;
+            cmp2 = address_cnt;
+            int address_cnt2 = (kon || (!b6 && address_cmp)) ? cmp1 : cmp2;
+
+            bool address_add = (!address_cmp && b6 && !b15) || (!address_cmp && !b6);
+            bool address_sub = !address_cmp && b6 && b15;
+            if (b7)
+                address_cnt2 -= address_add - address_sub;
+            else
+                address_cnt2 += address_add - address_sub;
+            address_cnt = address_cnt2 & 0xfffff; // 11
+            b15 = b6 && (b15 ^ address_cmp); // 11
+
+            int samp1 = (int8_t)PCM_RomFetch(pcm, rombanks, hiaddr, (uint32_t)(address_cnt)); // 20
+
+            cmp1 = address;
+            cmp2 = address_cnt;
+            const bool nibble_cmp3 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 12
+            cmp1 = b15 ? address_loop : address_end;
+            cmp2 = address_cnt;
+            address_cmp = (cmp1 & 0xfffff) == (cmp2 & 0xfffff); // 13
+
+            if (sub_phase_of >= 1)
+            {
+                next_address = address_cnt; // 13
+                usenew = !nibble_cmp3;
+                next_b15 = b15;
+            }
+
+            cmp1 = (!b6 && address_cmp) ? address_loop : address_cnt;
+            cmp2 = address_cnt;
+            address_cnt2 = (kon || (!b6 && address_cmp)) ? cmp1 : cmp2;
+
+            address_add = (!address_cmp && b6 && !b15) || (!address_cmp && !b6);
+            address_sub = !address_cmp && b6 && b15;
+            if (b7)
+                address_cnt2 -= address_add - address_sub;
+            else
+                address_cnt2 += address_add - address_sub;
+            address_cnt = address_cnt2 & 0xfffff; // 15
+            b15 = b6 && (b15 ^ address_cmp); // 15
+
+            int samp2 = (int8_t)PCM_RomFetch(pcm, rombanks, hiaddr, (uint32_t)(address_cnt)); // 1
+
+            cmp1 = address;
+            cmp2 = address_cnt;
+            const bool nibble_cmp4 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 16
+            cmp1 = b15 ? address_loop : address_end;
+            cmp2 = address_cnt;
+            address_cmp = (cmp1 & 0xfffff) == (cmp2 & 0xfffff); // 17
+
+            if (sub_phase_of >= 2)
+            {
+                next_address = address_cnt; // 17
+                usenew = !nibble_cmp4;
+                next_b15 = b15;
+            }
+
+            cmp1 = (!b6 && address_cmp) ? address_loop : address_cnt;
+            cmp2 = address_cnt;
+            address_cnt2 = (kon || (!b6 && address_cmp)) ? cmp1 : cmp2;
+
+            address_add = (!address_cmp && b6 && !b15) || (!address_cmp && !b6);
+            address_sub = !address_cmp && b6 && b15;
+            if (b7)
+                address_cnt2 -= address_add - address_sub;
+            else
+                address_cnt2 += address_add - address_sub;
+            address_cnt = address_cnt2 & 0xfffff; // 19
+            b15 = b6 && (b15 ^ address_cmp); // 19
+
+            int samp3 = (int8_t)PCM_RomFetch(pcm, rombanks, hiaddr, (uint32_t)(address_cnt)); // 5
+
+            cmp1 = address;
+            cmp2 = address_cnt;
+            const bool nibble_cmp5 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 20
+            cmp1 = b15 ? address_loop : address_end;
+            cmp2 = address_cnt;
+            address_cmp = (cmp1 & 0xfffff) == (cmp2 & 0xfffff); // 21
+
+            if (sub_phase_of >= 3)
+            {
+                next_address = address_cnt; // 21
+                usenew = !nibble_cmp5;
+                next_b15 = b15;
+            }
+
+            cmp1 = (!b6 && address_cmp) ? address_loop : address_cnt;
+            cmp2 = address_cnt;
+            address_cnt2 = (kon || (!b6 && address_cmp)) ? cmp1 : cmp2;
+
+            address_add = (!address_cmp && b6 && !b15) || (!address_cmp && !b6);
+            address_sub = !address_cmp && b6 && b15;
+            if (b7)
+                address_cnt2 -= address_add - address_sub;
+            else
+                address_cnt2 += address_add - address_sub;
+            address_cnt = address_cnt2 & 0xfffff; // 23
+            // b15 = b6 && (b15 ^ address_cmp); // 23
+
+            cmp1 = address;
+            cmp2 = address_cnt;
+            const bool nibble_cmp6 = (cmp1 & 0xffff0) == (cmp2 & 0xffff0); // 24
+
+            if (sub_phase_of >= 4)
+            {
+                next_address = address_cnt; // 1
+                usenew = !nibble_cmp6;
+                // b15 is not updated?
+            }
+
+            if (active && pcm.nfs)
+                ram1[4] = (uint32_t)next_address;
+
+            if (pcm.nfs)
+            {
+                ram2[8] &= ~0x8000;
+                ram2[8] |= (uint16_t)(next_b15 << 15);
+            }
+
+            // dpcm
+
+            // 18
+            int reference = (int)ram1[5];
+
+            // 19
+            int preshift = samp0 << 10;
+            int select_nibble = nibble_cmp2 ? old_nibble : newnibble;
+            int shift = (10 - select_nibble) & 15;
+
+            int shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 1)
+                reference = addclip20(reference, shifted >> 1, shifted & 1);
+
+            preshift = samp1 << 10;
+            select_nibble = nibble_cmp3 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+
+            shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 2)
+                reference = addclip20(reference, shifted >> 1, shifted & 1);
+
+            preshift = samp2 << 10;
+            select_nibble = nibble_cmp4 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+
+            shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 3)
+                reference = addclip20(reference, shifted >> 1, shifted & 1);
+
+            preshift = samp3 << 10;
+            select_nibble = nibble_cmp5 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+
+            shifted = (preshift << 1) >> shift;
+
+            if (sub_phase_of >= 4)
+                reference = addclip20(reference, shifted >> 1, shifted & 1);
+
+            // interpolation
+
+            int test = (int)ram1[5];
+
+            int step0 = multi(interp_lut[0][interp_ratio] << 6, (int8_t)samp0) >> 8;
+            select_nibble = nibble_cmp2 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+            step0 =  (step0 << 1) >> shift;
+
+            test = addclip20(test, step0 >> 1, step0 & 1);
+
+
+            int step1 = multi(interp_lut[1][interp_ratio] << 6, (int8_t)samp1) >> 8;
+            select_nibble = nibble_cmp3 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+            step1 = (step1 << 1) >> shift;
+
+            test = addclip20(test, step1 >> 1, step1 & 1);
+
+            int step2 = multi(interp_lut[2][interp_ratio] << 6, (int8_t)samp2) >> 8;
+            select_nibble = nibble_cmp4 ? old_nibble : newnibble;
+            shift = (10 - select_nibble) & 15;
+            step2 = (step2 << 1) >> shift;
+
+            int reg1 = (int)ram1[1];
+            int reg3 = (int)ram1[3];
+            int reg2_6 = (ram2[6] >> 8) & 127;
+
+            test = addclip20(test, step2 >> 1, step2 & 1);
+
+            int filter = ram2[11];
+            int v3;
+
+            if (pcm.mcu->is_mk1)
+            {
+                int mult1 = multi(reg1, (int8_t)(filter >> 8)); // 8
+                int mult2 = multi(reg1, (int8_t)((filter >> 1) & 127)); // 9
+                int mult3 = multi(reg1, (int8_t)reg2_6); // 10
+
+                int v2 = addclip20(reg3, mult1 >> 6, (mult1 >> 5) & 1); // 9
+                int v1 = addclip20(v2, mult2 >> 13, (mult2 >> 12) & 1); // 10
+                int subvar = addclip20(v1, (mult3 >> 6), (mult3 >> 5) & 1); // 11
+
+                ram1[3] = (uint32_t)v1;
+
+                v3 = addclip20(test, subvar ^ 0xfffff, 1); // 12
+
+                int mult4 = multi(v3, (int8_t)(filter >> 8));
+                int mult5 = multi(v3, (int8_t)((filter >> 1) & 127));
+                int v4 = addclip20(reg1, mult4 >> 6, (mult4 >> 5) & 1); // 14
+                int v5 = addclip20(v4, mult5 >> 13, (mult5 >> 12) & 1); // 15
+
+                ram1[1] = (uint32_t)v5;
+            }
+            else
+            {
+                // hack: use 32-bit math to avoid overflow
+                int mult1 = reg1 * (int8_t)(filter >> 8); // 8
+                int mult2 = reg1 * (int8_t)((filter >> 1) & 127); // 9
+                int mult3 = reg1 * (int8_t)reg2_6; // 10
+
+                int v2 = reg3 + (mult1 >> 6) + ((mult1 >> 5) & 1); // 9
+                int v1 = v2 + (mult2 >> 13) + ((mult2 >> 12) & 1); // 10
+                int subvar = v1 + (mult3 >> 6) + ((mult3 >> 5) & 1); // 11
+
+                ram1[3] = (uint32_t)v1;
+
+                int tests = test;
+                tests <<= 12;
+                tests >>= 12;
+
+                v3 = tests - subvar; // 12
+
+                int mult4 = v3 * (int8_t)(filter >> 8);
+                int mult5 = v3 * (int8_t)((filter >> 1) & 127);
+                int v4 = reg1 + (mult4 >> 6) + ((mult4 >> 5) & 1); // 14
+                int v5 = v4 + (mult5 >> 13) + ((mult5 >> 12) & 1); // 15
+
+                ram1[1] = (uint32_t)v5;
+            }
+
+
+            ram1[5] = (uint32_t)reference;
+
+            if (active && (ram2[6] & 1) != 0 && (ram2[8] & 0x4000) == 0 && !pcm.irq_assert && irq_flag)
+            {
+                //fprintf(stderr, "irq voice %i\n", slot);
+                if (pcm.nfs)
+                    ram2[8] |= 0x4000;
+                pcm.irq_assert = true;
+                pcm.irq_channel = (uint8_t)slot;
+                if (pcm.mcu->is_jv880)
+                    MCU_GA_SetGAInt(*pcm.mcu, 5, 1);
+                else
+                    // Skeletal JV880 shape: the assert goes DIRECT,
+                    // as Sterr1 sets its GA line from the PCM core.
+                    // (The old FIFO split's PushIrq branch is deleted
+                    // with the FIFO itself.) The assert-set (core 3,
+                    // under the state lock during a batch) and the
+                    // status-read ACK clear (core 2, under the state
+                    // lock) are serialized by the lock;
+                    // Interrupt_Handle only reads interrupt_pending,
+                    // so no unlocked RMW races the locked writers.
+                    // No double delivery: the IRQ FIFO no longer
+                    // exists, so this is the only delivery path.
+                    SplitAssertIrq0(pcm);
+            }
+
+            int volmul1 = 0;
+            int volmul2 = 0;
+
+            calc_tv(pcm, 0, ram2[3], &ram2[9], active, &volmul1);
+            calc_tv(pcm, 1, ram2[4], &ram2[10], active, &volmul2);
+            calc_tv(pcm, 2, ram2[5], &ram2[11], active, NULL);
+
+            int sample = (ram2[6] & 2) == 0 ? (int)ram1[3] : v3;
+
+            int pan = active ? ram2[1] : 0;
+            int rc = active ? ram2[2] : 0;
+
+            // Mix inputs for the cross-slot vector pass below.
+            mix_sample[slot] = sample;
+            mix_vm1[slot] = volmul1;
+            mix_vm2[slot] = volmul2;
+            mix_pan[slot] = pan;
+            mix_rc[slot] = rc;
+            {
+                // Slot2 injection terms, resolved here (same mapping as
+                // the original two switches); the vector pass adds them
+                // to the accumulators, order-free by the sx20
+                // homomorphism.
+                int slot2 = (slot == pcm.config.reg_slots - 1) ? 31 : slot + 1;
+                int32_t injL = 0, injR = 0, injC0 = 0, injC1 = 0;
+                switch (slot2)
+                {
+                    case 17:
+                        injL = sx20(rcadd[0] >> 1) + (rcadd[0] & 1);
+                        injC1 = sx20(rcadd2[0] >> 1) + (rcadd2[0] & 1);
+                        break;
+                    case 18:
+                        injR = sx20(rcadd[1] >> 1) + (rcadd[1] & 1);
+                        injC1 = sx20(rcadd2[1] >> 1) + (rcadd2[1] & 1);
+                        break;
+                    case 21:
+                        injL = sx20(rcadd[2] >> 1) + (rcadd[2] & 1);
+                        injC0 = sx20(rcadd2[2] >> 1) + (rcadd2[2] & 1);
+                        break;
+                    case 22:
+                        injR = sx20(rcadd[3] >> 1) + (rcadd[3] & 1);
+                        injC1 = sx20(rcadd2[3] >> 1) + (rcadd2[3] & 1);
+                        break;
+                    case 23:
+                        injL = sx20(rcadd[4] >> 1) + (rcadd[4] & 1);
+                        injC0 = sx20(rcadd2[4] >> 1) + (rcadd2[4] & 1);
+                        break;
+                    case 31:
+                        injR = sx20(rcadd[5] >> 1) + (rcadd[5] & 1);
+                        injC1 = sx20(rcadd2[5] >> 1) + (rcadd2[5] & 1);
+                        break;
+                }
+                mix_injL[slot] = injL;
+                mix_injR[slot] = injR;
+                mix_injC0[slot] = injC0;
+                mix_injC1[slot] = injC1;
+            }
+
+            if (key && pcm.nfs)
+            {
+                ram2[7] &= ~0xf020;
+                ram2[7] |= (uint16_t)(((usenew || kon) ? newnibble : old_nibble) << 12);
+
+                // update key
+                ram2[7] |= (uint16_t)(key << 5);
+            }
+
+            if (!active)
+            {
+                if (pcm.nfs)
+                {
+                    ram1[1] = 0;
+                    ram1[3] = 0;
+                    ram1[5] = 0;
+                }
+
+                ram2[8] = 0;
+                ram2[9] = 0;
+                ram2[10] = 0;
+            }
+        }
+        // Cross-slot NEON mix: the mix chain runs in .4s lanes over
+        // groups of 4 slots, so coefficient vectors are loaded from the
+        // contiguous mix_* arrays -- no per-slot packing. Lanes beyond
+        // reg_slots are zero in all arrays and contribute zero terms.
+        // Accumulation is into 4 vector accumulators, combined once
+        // below; by the sx20 homomorphism the combined values are
+        // congruent mod 2^20 to the original serial sums, and every
+        // downstream observation (sx20 reads, write_mask low bits) is
+        // therefore identical.
+        {
+            typedef int int32x4_t __attribute__((vector_size(16)));
+            int32x4_t vaccL = {0, 0, 0, 0};
+            int32x4_t vaccR = {0, 0, 0, 0};
+            int32x4_t vaccC0 = {0, 0, 0, 0};
+            int32x4_t vaccC1 = {0, 0, 0, 0};
+            const int ngroups = (pcm.config.reg_slots + 3) / 4;
+            for (int g = 0; g < ngroups; g++)
+            {
+                const int32_t *pSample = mix_sample + g * 4;
+                const int32_t *pVm1 = mix_vm1 + g * 4;
+                const int32_t *pVm2 = mix_vm2 + g * 4;
+                const int32_t *pPan = mix_pan + g * 4;
+                const int32_t *pRc = mix_rc + g * 4;
+                const int32_t *pInjL = mix_injL + g * 4;
+                const int32_t *pInjR = mix_injR + g * 4;
+                const int32_t *pInjC0 = mix_injC0 + g * 4;
+                const int32_t *pInjC1 = mix_injC1 + g * 4;
+                __asm__ volatile (
+                    // Inputs: q0=sample q1=vm1 q2=vm2 q3=pan q4=rc
+                    // q5=injL q6=injR q7=injC0 q8=injC1. Accumulators
+                    // are the "+w" operands (never hardcode their
+                    // registers); v0-v19/v30/v31 are clobbered scratch.
+                    "ldr q0, [%[pSample]]\n\t"
+                    "ldr q1, [%[pVm1]]\n\t"
+                    "ldr q2, [%[pVm2]]\n\t"
+                    "ldr q3, [%[pPan]]\n\t"
+                    "ldr q4, [%[pRc]]\n\t"
+                    "ldr q5, [%[pInjL]]\n\t"
+                    "ldr q6, [%[pInjR]]\n\t"
+                    "ldr q7, [%[pInjC0]]\n\t"
+                    "ldr q8, [%[pInjC1]]\n\t"
+                    // Broadcast constants (2 insns/group).
+                    "dup v30.4s, %w[c127]\n\t"
+                    "dup v31.4s, %w[c1]\n\t"
+                    // V_s = sx20(sample)
+                    "shl v9.4s, v0.4s, #12\n\t"
+                    "sshr v9.4s, v9.4s, #12\n\t"
+                    // volmul1 bytes: b1hi=(int8)(vm1>>8),
+                    // b1lo=(int8)((vm1>>1)&127)
+                    "sshr v10.4s, v1.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "sshr v11.4s, v1.4s, #1\n\t"
+                    "and v11.16b, v11.16b, v30.16b\n\t"
+                    "mul v12.4s, v9.4s, v10.4s\n\t"
+                    "mul v13.4s, v9.4s, v11.4s\n\t"
+                    // sample2 = sx20(mv1>>6)+sx20(mv2>>13)+cin
+                    "sshr v14.4s, v12.4s, #6\n\t"
+                    "shl v14.4s, v14.4s, #12\n\t"
+                    "sshr v14.4s, v14.4s, #12\n\t"
+                    "sshr v15.4s, v13.4s, #13\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "sshr v16.4s, v13.4s, #12\n\t"
+                    "sshr v17.4s, v12.4s, #5\n\t"
+                    "orr v16.16b, v16.16b, v17.16b\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v14.4s, v14.4s, v15.4s\n\t"
+                    "add v14.4s, v14.4s, v16.4s\n\t"
+                    // volmul2 bytes + multiv3/4
+                    "sshr v10.4s, v2.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "sshr v11.4s, v2.4s, #1\n\t"
+                    "and v11.16b, v11.16b, v30.16b\n\t"
+                    "shl v18.4s, v14.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    "mul v12.4s, v18.4s, v10.4s\n\t"
+                    "mul v13.4s, v18.4s, v11.4s\n\t"
+                    // sample3 (same shape as sample2)
+                    "sshr v14.4s, v12.4s, #6\n\t"
+                    "shl v14.4s, v14.4s, #12\n\t"
+                    "sshr v14.4s, v14.4s, #12\n\t"
+                    "sshr v15.4s, v13.4s, #13\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "sshr v16.4s, v13.4s, #12\n\t"
+                    "sshr v17.4s, v12.4s, #5\n\t"
+                    "orr v16.16b, v16.16b, v17.16b\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v14.4s, v14.4s, v15.4s\n\t"
+                    "add v14.4s, v14.4s, v16.4s\n\t"
+                    // sx20(sample3), shared by pan/rc multis
+                    "shl v18.4s, v14.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    // pan bytes + sampl/sampr
+                    "sshr v10.4s, v3.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "shl v11.4s, v3.4s, #24\n\t"
+                    "sshr v11.4s, v11.4s, #24\n\t"
+                    "mul v12.4s, v18.4s, v10.4s\n\t"
+                    "mul v13.4s, v18.4s, v11.4s\n\t"
+                    // rc bytes + rc0/rc1 (>>5)
+                    "sshr v10.4s, v4.4s, #8\n\t"
+                    "shl v10.4s, v10.4s, #24\n\t"
+                    "sshr v10.4s, v10.4s, #24\n\t"
+                    "shl v11.4s, v4.4s, #24\n\t"
+                    "sshr v11.4s, v11.4s, #24\n\t"
+                    "mul v15.4s, v18.4s, v10.4s\n\t"
+                    "sshr v15.4s, v15.4s, #5\n\t"
+                    "mul v16.4s, v18.4s, v11.4s\n\t"
+                    "sshr v16.4s, v16.4s, #5\n\t"
+                    // termL = sx20(sampl>>6) + ((sampl>>5)&1)
+                    "sshr v17.4s, v12.4s, #6\n\t"
+                    "shl v17.4s, v17.4s, #12\n\t"
+                    "sshr v17.4s, v17.4s, #12\n\t"
+                    "sshr v18.4s, v12.4s, #5\n\t"
+                    "and v18.16b, v18.16b, v31.16b\n\t"
+                    "add v17.4s, v17.4s, v18.4s\n\t"
+                    // termR
+                    "sshr v18.4s, v13.4s, #6\n\t"
+                    "shl v18.4s, v18.4s, #12\n\t"
+                    "sshr v18.4s, v18.4s, #12\n\t"
+                    "sshr v19.4s, v13.4s, #5\n\t"
+                    "and v19.16b, v19.16b, v31.16b\n\t"
+                    "add v18.4s, v18.4s, v19.4s\n\t"
+                    // termC0 = sx20(rc0>>1) + (rc0&1)
+                    "sshr v19.4s, v15.4s, #1\n\t"
+                    "shl v19.4s, v19.4s, #12\n\t"
+                    "sshr v19.4s, v19.4s, #12\n\t"
+                    "and v15.16b, v15.16b, v31.16b\n\t"
+                    "add v19.4s, v19.4s, v15.4s\n\t"
+                    // termC1
+                    "sshr v15.4s, v16.4s, #1\n\t"
+                    "shl v15.4s, v15.4s, #12\n\t"
+                    "sshr v15.4s, v15.4s, #12\n\t"
+                    "and v16.16b, v16.16b, v31.16b\n\t"
+                    "add v15.4s, v15.4s, v16.4s\n\t"
+                    // Accumulate (operand registers, never hardcoded).
+                    "add %[vaccL].4s, %[vaccL].4s, v17.4s\n\t"
+                    "add %[vaccL].4s, %[vaccL].4s, v5.4s\n\t"
+                    "add %[vaccR].4s, %[vaccR].4s, v18.4s\n\t"
+                    "add %[vaccR].4s, %[vaccR].4s, v6.4s\n\t"
+                    "add %[vaccC0].4s, %[vaccC0].4s, v19.4s\n\t"
+                    "add %[vaccC0].4s, %[vaccC0].4s, v7.4s\n\t"
+                    "add %[vaccC1].4s, %[vaccC1].4s, v15.4s\n\t"
+                    "add %[vaccC1].4s, %[vaccC1].4s, v8.4s\n\t"
+                    : [vaccL] "+w" (vaccL), [vaccR] "+w" (vaccR),
+                      [vaccC0] "+w" (vaccC0), [vaccC1] "+w" (vaccC1)
+                    : [pSample] "r" (pSample), [pVm1] "r" (pVm1),
+                      [pVm2] "r" (pVm2), [pPan] "r" (pPan),
+                      [pRc] "r" (pRc), [pInjL] "r" (pInjL),
+                      [pInjR] "r" (pInjR), [pInjC0] "r" (pInjC0),
+                      [pInjC1] "r" (pInjC1), [c127] "r" (127),
+                      [c1] "r" (1)
+                    : "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7",
+                      "v8", "v9", "v10", "v11", "v12", "v13", "v14",
+                      "v15", "v16", "v17", "v18", "v19", "v30", "v31",
+                      "memory");
+            }
+            // Combine: horizontal sums of the 4 lanes. Store the
+            // vectors to the stack once per tick and sum in C (the
+            // per-tick cost is negligible; ADDV would save ~20 insns
+            // per tick and is left as a micro-optimization).
+            int32_t hL[4], hR[4], hC0[4], hC1[4];
+            __asm__ volatile (
+                "st1 {%[vaccL].4s}, [%[hL]]\n\t"
+                "st1 {%[vaccR].4s}, [%[hR]]\n\t"
+                "st1 {%[vaccC0].4s}, [%[hC0]]\n\t"
+                "st1 {%[vaccC1].4s}, [%[hC1]]\n\t"
+                : : [vaccL] "w" (vaccL), [vaccR] "w" (vaccR),
+                    [vaccC0] "w" (vaccC0), [vaccC1] "w" (vaccC1),
+                    [hL] "r" (hL), [hR] "r" (hR),
+                    [hC0] "r" (hC0), [hC1] "r" (hC1)
+                : "memory");
+            pcm.accum_l = hL[0] + hL[1] + hL[2] + hL[3];
+            pcm.accum_r = hR[0] + hR[1] + hR[2] + hR[3];
+            pcm.rcsum[0] = hC0[0] + hC0[1] + hC0[2] + hC0[3];
+            pcm.rcsum[1] = hC1[0] + hC1[1] + hC1[2] + hC1[3];
+            // ram1[31][1]/[3] intentionally left at their pre-loop
+            // zero (unobserved after the tick; see splitacc note).
+        }
+
+        // PMU (shaped-var): voice-mix cycles for this batch,
+        // accumulated PER BATCH (not per tick) to keep read overhead
+        // negligible. NOP-corrected, clamped at 0.
+        if (g_splitT)
+        {
+            const uint64_t nMixDelta = PMU_ReadCycles() - nMixStartCyc;
+            const uint64_t nMixNop = g_splitT->nop_cyc3;
+            g_splitT->mix_cyc = g_splitT->mix_cyc + (nMixDelta >= nMixNop ? nMixDelta - nMixNop : 0);
+        }
+
+        if (pcm.nfs)
+        {
+            pcm.ram2[31][7] |= 0x20;
+        }
+
+        pcm.nfs = true;
+
+        uint64_t new_cycles = (uint64_t)(pcm.config.reg_slots + 1) * 25;
+
+        pcm.cycles += pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles;
+
+        // mt32-pi dual-core split: publish the RenderStep of the tick
+        // that just advanced, so the MCU thread's tick rule can tell
+        // which ticks have rendered. No-op when inactive / JV880.
+        // The advance passed is the actual cycles advanced (JV880
+        // scales it), mirroring the prototype.
+        if (g_splitT)
+            g_splitT->PublishRenderedStep(pcm, pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles);
+    }
+
+    if (nProfileStart)
+    {
+        NukedProfile().nPCMUs += pProfileClock() - nProfileStart;
+        ++NukedProfile().nPCMUpdates;
+    }
+}
+#endif // defined(__aarch64__)
+
+// Variant descriptor table (data-driven dispatch, 2026-10-31
+// ~09:39): adding a variant is one table entry + its PCM_Update_*
+// function -- no switch to rewrite. The table now has six entries;
+// minimal.cpp sequence_done fields were extended to match (v4, v5).
+const PCMVariantDesc g_pcmVariants[] = {
+    {0, "baseline", "shaped-diag code path unchanged", PCM_Update},
+    {1, "sched", "round-1 lambda-pair slot loop", PCM_Update_Sched},
+    {2, "pipe", "round-2 head/tail pair split", PCM_Update_Pipe},
+#if defined(__aarch64__)
+    {3, "neon2", "round-2 NEON mix-tail v2 (no lane inserts, full-width loads)", PCM_Update_Neon2},
+    {4, "splitacc", "round-3 NEON v2 block + even/odd split accumulators", PCM_Update_Splitacc},
+    {5, "layout", "round-3 cross-slot NEON, no per-slot packing", PCM_Update_Layout},
+#endif
+    // Round 3b (scalar, host-verified against variant 0 by tools/hosttest):
+    {6, "romfast", "round-3b per-slot ROM bank pointers: PCM_ReadROM's bank switch resolved once per slot, 5 fetches become indexed loads", PCM_Update_RomFast},
+    {7, "scalacc", "round-3b exact register accumulators for the mix bus / reverb / chorus sums (scalar form of B2; no per-slot bus load/store)", PCM_Update_ScalarAcc},
+    {8, "romacc", "round-3b romfast + scalacc combined", PCM_Update_RomAcc},
+#if defined(__aarch64__)
+    {9, "layoutrom", "round-3b layout (cross-slot NEON mix) + romfast fetch path (NEON part unchanged; gate pending)", PCM_Update_LayoutRom},
+#endif
+};
+const int g_pcmVariantCount = sizeof(g_pcmVariants) / sizeof(g_pcmVariants[0]);
+
+// Table-driven dispatcher: linear search by number (4 entries:
+// negligible vs a batch). Unknown numbers fall back to baseline
+// (entry 0), so a stale/corrupt variant can never select a
+// nonexistent path.
+void PCM_Update_Variant(pcm_t& pcm, uint64_t cycles, int variant)
+{
+    for (int i = 0; i < g_pcmVariantCount; ++i)
+    {
+        if (g_pcmVariants[i].number == variant)
+        {
+            g_pcmVariants[i].update(pcm, cycles);
+            return;
+        }
+    }
+    g_pcmVariants[0].update(pcm, cycles);
+}
