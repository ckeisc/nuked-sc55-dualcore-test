+        }
+
+        pcm.nfs = true;
+
+        uint64_t new_cycles = (uint64_t)(pcm.config.reg_slots + 1) * 25;
+
+        pcm.cycles += pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles;
+
+        // mt32-pi dual-core split: publish the RenderStep of the tick
+        // that just advanced, so the MCU thread's tick rule can tell
+        // which ticks have rendered. No-op when inactive / JV880.
+        // The advance passed is the actual cycles advanced (JV880
+        // scales it), mirroring the prototype.
+        if (g_splitT)
+            g_splitT->PublishRenderedStep(pcm, pcm.mcu->is_jv880 ? (new_cycles * 25) / 29 : new_cycles);
+    }
+
+    if (nProfileStart)
+    {
+        NukedProfile().nPCMUs += pProfileClock() - nProfileStart;
+        ++NukedProfile().nPCMUpdates;
+    }
