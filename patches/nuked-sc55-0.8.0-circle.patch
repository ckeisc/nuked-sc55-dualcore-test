+            }
+        }
+
+        { // global counter for envelopes
+            if (!pcm.nfs)
+                pcm.tv_counter = pcm.ram2[31][8]; // fixme
+
+            pcm.tv_counter -= 1;
+
+            pcm.tv_counter &= 0x3fff;
+        }
+
+        // chorus/reverb
+
+        { // fixme
+            if (pcm.ram2[31][8] & 0x8000)
+                pcm.ram2[31][9] = pcm.ram2[31][8] & 0x7fff;
+            else
